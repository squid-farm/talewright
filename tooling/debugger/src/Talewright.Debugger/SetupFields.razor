<details>
    <summary>@Title</summary>
    <p>Enable only the values to override. Other fields retain their values. Quantities are absolute, zero removes an item. Base stats use ruleset clamping.</p>
    <label>Filter @Prefix fields <input aria-label="@($"Filter {Prefix} fields")" @bind="_filter" @bind:event="oninput" /></label>
    <fieldset>
        <legend>Flags</legend>
        @foreach (var flag in Flags.Where(f => $"flag:{f.Id}".Contains(_filter, StringComparison.OrdinalIgnoreCase)))
        {
            <div class="setup-row">
                <label><input type="checkbox" aria-label="@($"{OverrideLabel} flag:{flag.Id}")" @bind="flag.Enabled" /> @OverrideLabel flag:@flag.Id</label>
                <label><input type="checkbox" aria-label="@($"{ValueLabel} flag:{flag.Id}")" @bind="flag.Value" /> Value</label>
            </div>
        }
    </fieldset>
    <fieldset>
        <legend>Integer variables, standings, base stats and inventory</legend>
        @foreach (var field in Numbers.Where(f => f.Label.Contains(_filter, StringComparison.OrdinalIgnoreCase)))
        {
            <div class="setup-row">
                <label><input type="checkbox" aria-label="@($"{OverrideLabel} {field.Label}")" @bind="field.Enabled" /> @field.Label</label>
                <label>Value <input aria-label="@($"{ValueLabel} {field.Label}")" inputmode="numeric" @bind="field.Value" /></label>
            </div>
        }
    </fieldset>
    <fieldset>
        <legend>Text variables</legend>
        <p>Values are literal text, without surrounding quotes. Enable an override with an empty field to set empty text.</p>
        @foreach (var field in Texts.Where(f => f.Label.Contains(_filter, StringComparison.OrdinalIgnoreCase)))
        {
            <div class="setup-row">
                <label><input type="checkbox" aria-label="@($"{OverrideLabel} {field.Label}")" @bind="field.Enabled" /> @field.Label (text)</label>
                <label>Value <textarea aria-label="@($"{ValueLabel} {field.Label}")" @bind="field.Value"></textarea></label>
            </div>
        }
    </fieldset>
</details>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SetupNumber> Numbers { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<SetupFlag> Flags { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<SetupText> Texts { get; set; } = [];
    [Parameter] public string Title { get; set; } = "Prerequisite overrides";
    [Parameter] public string Prefix { get; set; } = "setup";
    private string OverrideLabel => Prefix == "setup" ? "Override" : "Edit";
    private string ValueLabel => Prefix == "setup" ? "Value" : "Edit value";
    private string _filter = "";
}
