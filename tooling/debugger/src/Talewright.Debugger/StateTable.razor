<div class="tool-filters">
    <label>Filter inspection <input aria-label="Filter inspection" value="@Filter" @oninput="OnFilterInput" /></label>
</div>
@foreach (var character in Inspection.FindCharacters(Filter))
{
    <details>
        <summary>@character.Id: @character.FirstName @character.LastName</summary>
        <p>Pronouns: @character.Pronouns</p>
        <table><caption>Base and effective stats</caption><thead><tr><th>Stat</th><th>Base</th><th>Effective</th></tr></thead>
            <tbody>@foreach (var stat in character.Stats)
            {
                <tr><th>@stat.Id @stat.Name</th><td>@(stat.ExactBaseValue ?? stat.BaseValue.ToString())</td><td>@(stat.ExactEffectiveValue ?? stat.EffectiveValue.ToString())</td></tr>
            }</tbody>
        </table>
        <ul>
            @foreach (var item in character.Inventory)
            {
                if (item.Groups is { } groups)
                {
                    <li>
                        @item.Id @item.Name:
                        <ol class="item-group-list">
                            @for (var index = 0; index < groups.Count; index++)
                            {
                                var group = groups[index];
                                <li>@group.Quantity @string.Join(", ", group.Properties.Select(PropertyText))@(index == 0 ? " (front)" : "")</li>
                            }
                        </ol>
                    </li>
                }
                else
                {
                    <li>@item.Id @item.Name: @(item.ExactQuantity ?? item.Quantity.ToString())</li>
                }
            }
        </ul>
    </details>
}
<details>
    <summary>Flags, variables, factions, visits and triggers</summary>
    <ul>
        @foreach (var flag in Inspection.Flags.Where(v => Match($"flag:{v.Key}"))) { <li>flag:@flag.Key = @flag.Value</li> }
        @foreach (var variable in Inspection.ExactVariables.Where(v => Match($"var:{v.Key}")))
        {
            <li>var:@variable.Key (@(Inspection.TalemarkVersion == 1 ? "integer" : "number")) = @variable.Value</li>
        }
        @foreach (var variable in Inspection.TextVariables.Where(v => Match($"var:{v.Key}")))
        {
            <li>var:@variable.Key (text) = <code>@System.Text.Json.JsonSerializer.Serialize(variable.Value)</code></li>
        }
        @foreach (var faction in Inspection.Factions.Where(v => Match(v.Id.Value))) { <li>faction:@faction.Id = @faction.Standing (@faction.Tier)</li> }
        @foreach (var scene in Inspection.Scenes.Where(v => Match(v.Id.Value)).Take(100)) { <li>@scene.Id visits: @scene.Visits</li> }
        @foreach (var trigger in Inspection.Triggers.Where(v => Match(v.Id))) { <li>@trigger.Id fired: @trigger.HasFired</li> }
    </ul>
    <p class="tool-note">Showing at most 100 scene visit rows. Narrow the inspection filter to find other scenes.</p>
</details>

@code {
    [Parameter, EditorRequired] public AuthorInspection Inspection { get; set; } = null!;
    [Parameter] public string Filter { get; set; } = "";
    [Parameter] public EventCallback<string> FilterChanged { get; set; }

    private Task OnFilterInput(ChangeEventArgs args) =>
        FilterChanged.InvokeAsync(args.Value?.ToString() ?? "");
    private bool Match(string text) => text.Contains(Filter, StringComparison.OrdinalIgnoreCase);
    private static string PropertyText(Talewright.Core.State.ItemPropertySnapshot property) =>
        $"{property.Key} {(property.Kind == Talewright.Core.State.ItemPropertyValueKind.Text
            ? System.Text.Json.JsonSerializer.Serialize(property.Value) : property.Value)}";
}
