@using Talewright.Talemark.Formatting
<li>
    @if (_talemark is { } talemark) { <code>@talemark</code> } else { <em>Talemark text unavailable: @_unavailable</em> }:
    <strong>@(Trace.Result is { Type: ExprType.Text } text ? System.Text.Json.JsonSerializer.Serialize(text.Text) : Trace.Result?.ToString() ?? "Not evaluated")</strong>
    @if (Trace.IsOpaque)
    {
        <span> (opaque C# predicate; internals unavailable)</span>
    }
    @if (Trace.Children.Count > 0)
    {
        @if (Depth < MaximumDisplayDepth)
        {
            <ul>
                @foreach (var child in Trace.Children)
                {
                    <ExpressionView Trace="child" Depth="@(Depth + 1)" />
                }
            </ul>
        }
        else
        {
            <span>Additional expression details omitted.</span>
        }
    }
</li>

@code {
    private const int MaximumDisplayDepth = 64;

    [Parameter, EditorRequired] public ExpressionTrace Trace { get; set; } = default!;
    [Parameter] public int Depth { get; set; }
    private string? _talemark;
    private string? _unavailable;

    protected override void OnParametersSet()
    {
        try
        {
            _talemark = ExpressionFormatter.Format(Trace.Expression);
            _unavailable = null;
        }
        // Parsed stories always format; host-built trees may not, and must not break inspection.
        catch (Exception ex) when (ex is ArgumentException or NotSupportedException)
        {
            _talemark = null;
            _unavailable = ex.Message;
        }
    }
}
