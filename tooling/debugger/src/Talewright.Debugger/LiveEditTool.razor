<section aria-label="Live state editing">
    <h3>Live state editing</h3>
    <details>
        <summary>How live editing works</summary>
        <p>One validated batch, followed by normal triggers and leveling. No scene re-entry or entry-check reroll. After success, fields show actual values and enabled edits are cleared. Consequences appear in command history.</p>
    </details>
    <SetupFields Numbers="Model.EditNumbers" Flags="Model.EditFlags" Texts="Model.EditTexts" Title="Live edit values" Prefix="live" />
    <button type="button" disabled="@Session.Current.IsEnded" @onclick="OnApplyEdits">Apply live edit batch</button>
    @if (Session.Current.IsEnded)
    {
        <p>Ended runs cannot be edited. Go Back, or use Start selected scene for a fresh-world jump.</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public WorkbenchModel Model { get; set; } = null!;
    [Parameter, EditorRequired] public AuthorSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnApplyEdits { get; set; }
}
