@using Talewright.Core.Events

<details open="@Open">
    <summary>Events</summary>
    <p class="tool-note">Zero-based event offsets; showing the most recent 200 matching events.</p>
    <ul>@foreach (var entry in Inspection.Events.Select((item, index) => (item, index)).Where(e => Match(Describe(e.item))).TakeLast(200))
    {
        <li>@entry.index: @Describe(entry.item)</li>
    }</ul>
</details>

@code {
    [Parameter, EditorRequired] public AuthorInspection Inspection { get; set; } = null!;
    [Parameter] public string Filter { get; set; } = "";
    [Parameter] public bool Open { get; set; }

    private static string Describe(GameEvent gameEvent) =>
        gameEvent is SkillCheckResolved { IsHidden: true } ? $"{gameEvent} (hidden)" : gameEvent.ToString() ?? "";

    private bool Match(string text) => text.Contains(Filter, StringComparison.OrdinalIgnoreCase);
}
