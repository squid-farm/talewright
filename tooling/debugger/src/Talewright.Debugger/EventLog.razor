<details>
    <summary>Events</summary>
    <p>Zero-based event offsets; showing the most recent 200 matching events.</p>
    <ul>@foreach (var entry in Inspection.Events.Select((item, index) => (item, index)).Where(e => Match(e.item.ToString())).TakeLast(200))
    {
        <li>@entry.index: @entry.item</li>
    }</ul>
</details>

@code {
    [Parameter, EditorRequired] public AuthorInspection Inspection { get; set; } = null!;
    [Parameter] public string Filter { get; set; } = "";

    private bool Match(string? text) => (text ?? "").Contains(Filter, StringComparison.OrdinalIgnoreCase);
}
