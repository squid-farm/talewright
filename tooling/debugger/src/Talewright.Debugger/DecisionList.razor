@using Talewright.Core.Identity
@using Talewright.Rules.Diagnostics
@using Talewright.Talemark.Model

@foreach (var decision in Inspection.FindDecisions(Filter, Kind).TakeLast(100))
{
    var status = DebuggerDecisionStatus.ForDecision(decision);
    <div class="decision-list-entry">
        <details open="@ReferenceEquals(decision, ExpandedDecision)">
            <summary>@decision.Kind @decision.Scene @decision.Subject: @decision.Outcome (@decision.Reason)@if (status is not null) { <text> — @status</text> }</summary>
            @if (SelectionFor(decision) is { } selection)
            {
                <button type="button" @onclick="() => OnInspectSelection.InvokeAsync(selection)">
                    @(selection.ChoiceKey is null ? "Inspect scene" : "Inspect choice")
                </button>
            }
            @if (Inspection.SourceFor(decision) is { } source)
            {
                <p>Source: @source.Start.File:@source.Start.Line:@source.Start.Column</p>
            }
            <p>Events [@decision.EventStart, @decision.EventEnd).
                @if (decision.Pass is { } pass) { <text> Pass: @pass.</text> }
                @if (decision.Priority is { } priority) { <text> Priority: @priority.</text> }
                @if (decision.Rank is { } rank) { <text> Rank: @rank.</text> }
                @if (decision.Limit is { } limit) { <text> Limit: @limit.</text> }
            </p>
            @if (decision.Expression is { } expression && status != DebuggerDecisionStatus.ShownUnavailable)
            {
                <ul><ExpressionView Trace="expression" /></ul>
            }
            @if (decision.EventStart is { } start && decision.EventEnd is { } end && end > start)
            {
                <ul>@foreach (var item in Inspection.Events.Skip(start).Take(end - start)) { <li>@item</li> }</ul>
            }
        </details>
        @if (status == DebuggerDecisionStatus.ShownUnavailable && decision.Expression is { } trace)
        {
            <div class="decision-failing-requirement" aria-label="Failing requires">
                <strong>Failing requires</strong>
                <ul><ExpressionView Trace="trace" /></ul>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public AuthorInspection Inspection { get; set; } = null!;
    [Parameter] public string Filter { get; set; } = "";
    [Parameter] public DecisionKind? Kind { get; set; }
    [Parameter] public StoryDefinition? Story { get; set; }
    [Parameter] public RuleDecision? ExpandedDecision { get; set; }
    [Parameter] public EventCallback<InspectorSelection> OnInspectSelection { get; set; }

    private InspectorSelection? SelectionFor(RuleDecision decision)
    {
        if (Story is null)
            return null;

        if (decision.Kind == DecisionKind.Storylet &&
            Story.Scenes.Any(scene => scene.Id.Value == decision.Subject))
        {
            return new(new SceneId(decision.Subject));
        }

        if (decision.Kind == DecisionKind.Choice && decision.Scene is { } choiceScene)
        {
            var choiceStep = SceneSteps.Walk(Story.GetScene(choiceScene).Steps)
                .OfType<ChoiceStep>().FirstOrDefault(step => step.Id == decision.Subject);
            return choiceStep is null ? null : new(choiceScene, choiceStep.Choice.Key);
        }

        return decision.Scene is { } scene && Story.Scenes.Any(candidate => candidate.Id == scene)
            ? new(scene)
            : null;
    }
}
