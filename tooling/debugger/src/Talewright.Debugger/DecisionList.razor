@foreach (var decision in Inspection.FindDecisions(Filter, Kind).TakeLast(100))
{
    <details>
        <summary>@decision.Kind @decision.Scene @decision.Subject: @decision.Outcome (@decision.Reason)</summary>
        @if (Inspection.SourceFor(decision) is { } source)
        {
            <p>Source: @source.Start.File:@source.Start.Line:@source.Start.Column</p>
        }
        <p>Events [@decision.EventStart, @decision.EventEnd).
            @if (decision.Pass is { } pass) { <text> Pass: @pass.</text> }
            @if (decision.Priority is { } priority) { <text> Priority: @priority.</text> }
            @if (decision.Rank is { } rank) { <text> Rank: @rank.</text> }
            @if (decision.Limit is { } limit) { <text> Limit: @limit.</text> }
        </p>
        @if (decision.Expression is { } expression) { <ul><ExpressionView Trace="expression" /></ul> }
        @if (decision.EventStart is { } start && decision.EventEnd is { } end && end > start)
        {
            <ul>@foreach (var item in Inspection.Events.Skip(start).Take(end - start)) { <li>@item</li> }</ul>
        }
    </details>
}

@code {
    [Parameter, EditorRequired] public AuthorInspection Inspection { get; set; } = null!;
    [Parameter] public string Filter { get; set; } = "";
    [Parameter] public DecisionKind? Kind { get; set; }
}
