<section class="setup-tool" aria-label="Scene setup">
    <h2 class="visually-hidden">Scene setup</h2>
    <div class="setup-body">
        <div class="setup-scenes">
            <ScenePicker Model="Model" OnSelect="SelectTarget" />
        </div>
        <div class="setup-options">
            @if (Story.Creation is not null)
            {
                <div class="setup-character">
                    <CharacterCreator @key="Model.CreationRevision" Story="Story" Seed="Model.CreationSeed" InitialSelection="Model.Character" OnCreated="Model.SelectCharacter" Compact="true" />
                    <div class="setup-character-status">
                        <p role="status" class="@(Model.Character is null ? "setup-character-missing" : "setup-character-ready")">@(Model.Character is null ? "Create a character before starting the selected scene. Start story above confirms the character only." : "Character selected. Start the selected scene below.")</p>
                        <button type="button" @onclick="OnClearCharacter">Clear character selection</button>
                    </div>
                </div>
            }
            <SetupFields Numbers="Model.Numbers" Flags="Model.Flags" Texts="Model.Texts" />
        </div>
    </div>
    <div class="setup-actions">
        <label>Target scene ID <input aria-label="Target scene ID" @bind="Model.Target" /></label>
        <label>Seed (empty uses story/random default) <input class="setup-seed" aria-label="Seed" inputmode="numeric" @bind="Model.Seed" /></label>
        <button type="button" class="setup-start" @onclick="OnStart">Start selected scene</button>
        @if (Model.Session is { } session)
        {
            <button type="button" disabled="@session.Current.IsEnded" @onclick="OnJumpPreservingState">Jump retaining state</button>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public WorkbenchModel Model { get; set; } = null!;
    [Parameter, EditorRequired] public StoryDefinition Story { get; set; } = null!;
    [Parameter] public EventCallback OnStart { get; set; }
    [Parameter] public EventCallback OnClearCharacter { get; set; }
    [Parameter] public EventCallback OnJumpPreservingState { get; set; }

    private void SelectTarget(string sceneId) => Model.Target = sceneId;
}
