<section aria-label="State inspection">
    <h2>State inspection</h2>
    <StateTable Inspection="Inspection" Filter="@_filter" FilterChanged="SetFilter" />
    <EventLog Inspection="Inspection" Filter="@_filter" />
</section>
<BranchesTool Inspection="Inspection" />

@code {
    [Parameter, EditorRequired] public AuthorInspection Inspection { get; set; } = null!;
    private string _filter = "";
    private void SetFilter(string filter) => _filter = filter;
}
