<div class="debugger-tools">
    <div class="tool-strip">
        <div role="tablist" aria-label="Debugger tools" class="tool-tabs">
            <button type="button" role="tab" id="tool-setup-tab" aria-controls="tool-setup-panel"
                    aria-selected="@(Selected == "Setup" ? "true" : "false")" tabindex="@(Selected == "Setup" ? 0 : -1)"
                    @ref="_setupTab" @onclick='() => Select("Setup")' @onkeydown='args => HandleKey("Setup", args)'>Setup</button>
            <button type="button" role="tab" id="tool-state-tab" aria-controls="tool-state-panel"
                    aria-selected="@(Selected == "State" ? "true" : "false")" tabindex="@(Selected == "State" ? 0 : -1)"
                    @ref="_stateTab" @onclick='() => Select("State")' @onkeydown='args => HandleKey("State", args)'>State</button>
            <button type="button" role="tab" id="tool-source-tab" aria-controls="tool-source-panel"
                    aria-selected="@(Selected == "Source" ? "true" : "false")" tabindex="@(Selected == "Source" ? 0 : -1)"
                    @ref="_sourceTab" @onclick='() => Select("Source")' @onkeydown='args => HandleKey("Source", args)'>Source</button>
            <button type="button" role="tab" id="tool-branches-tab" aria-controls="tool-branches-panel"
                    aria-selected="@(Selected == "Branches" ? "true" : "false")" tabindex="@(Selected == "Branches" ? 0 : -1)"
                    @ref="_branchesTab" @onclick='() => Select("Branches")' @onkeydown='args => HandleKey("Branches", args)'>Branches</button>
            <button type="button" role="tab" id="tool-timeline-tab" aria-controls="tool-timeline-panel"
                    aria-selected="@(Selected == "Timeline" ? "true" : "false")" tabindex="@(Selected == "Timeline" ? 0 : -1)"
                    @ref="_timelineTab" @onclick='() => Select("Timeline")' @onkeydown='args => HandleKey("Timeline", args)'>Timeline</button>
            <button type="button" role="tab" id="tool-events-tab" aria-controls="tool-events-panel"
                    aria-selected="@(Selected == "Events" ? "true" : "false")" tabindex="@(Selected == "Events" ? 0 : -1)"
                    @ref="_eventsTab" @onclick='() => Select("Events")' @onkeydown='args => HandleKey("Events", args)'>Events</button>
            <button type="button" role="tab" id="tool-problems-tab" aria-controls="tool-problems-panel"
                    aria-selected="@(Selected == "Problems" ? "true" : "false")" tabindex="@(Selected == "Problems" ? 0 : -1)"
                    @ref="_problemsTab" @onclick='() => Select("Problems")' @onkeydown='args => HandleKey("Problems", args)'>Problems</button>
        </div>
    </div>
    @Panel("Setup", Setup, fill: true)
    @Panel("State", State, fill: true)
    @Panel("Source", Source, fill: true)
    @Panel("Branches", Branches)
    @Panel("Timeline", Timeline)
    @Panel("Events", Events)
    @Panel("Problems", Problems)
</div>

@code {
    private static readonly string[] Tabs = ["Setup", "State", "Source", "Branches", "Timeline", "Events", "Problems"];
    private ElementReference _setupTab;
    private ElementReference _stateTab;
    private ElementReference _sourceTab;
    private ElementReference _branchesTab;
    private ElementReference _timelineTab;
    private ElementReference _eventsTab;
    private ElementReference _problemsTab;

    [Parameter] public string Selected { get; set; } = "Setup";
    [Parameter] public EventCallback<string> SelectedChanged { get; set; }
    [Parameter] public RenderFragment? Setup { get; set; }
    [Parameter] public RenderFragment? State { get; set; }
    [Parameter] public RenderFragment? Source { get; set; }
    [Parameter] public RenderFragment? Branches { get; set; }
    [Parameter] public RenderFragment? Timeline { get; set; }
    [Parameter] public RenderFragment? Events { get; set; }
    [Parameter] public RenderFragment? Problems { get; set; }

    public Task Select(string tab) => SelectedChanged.InvokeAsync(tab);

    private RenderFragment Panel(string tab, RenderFragment? content, bool fill = false) => @<section
        role="tabpanel" id="@PanelId(tab)" aria-labelledby="@TabId(tab)" tabindex="0" hidden="@(Selected != tab)"
        class="@(fill ? "tool-panel tool-panel-fill" : "tool-panel")">
        @content
    </section>;

    private async Task HandleKey(string tab, KeyboardEventArgs args)
    {
        var index = Array.IndexOf(Tabs, tab);
        var selected = args.Key switch
        {
            "ArrowRight" => Tabs[(index + 1) % Tabs.Length],
            "ArrowLeft" => Tabs[(index - 1 + Tabs.Length) % Tabs.Length],
            "Home" => Tabs[0],
            "End" => Tabs[^1],
            _ => null,
        };
        if (selected is null)
            return;
        await Select(selected);
        await FocusTab(selected);
    }

    private static string TabId(string tab) => $"tool-{tab.ToLowerInvariant()}-tab";
    private static string PanelId(string tab) => $"tool-{tab.ToLowerInvariant()}-panel";

    private async Task FocusTab(string tab)
    {
        switch (tab)
        {
            case "Setup": await _setupTab.FocusAsync(); break;
            case "State": await _stateTab.FocusAsync(); break;
            case "Source": await _sourceTab.FocusAsync(); break;
            case "Branches": await _branchesTab.FocusAsync(); break;
            case "Timeline": await _timelineTab.FocusAsync(); break;
            case "Events": await _eventsTab.FocusAsync(); break;
            case "Problems": await _problemsTab.FocusAsync(); break;
        }
    }
}
