<h3 class="debugger-scene-heading">@Session.Current.Scene @Session.Current.Title</h3>
<ReaderPresentation>
    <StoryStage Story="Session.Story" Passages="Passages" PassageWindow="1" Current="Session.Current"
                State="Session.State" Identity="Session" AtChoiceLimit="AtLimit" Busy="false"
                OnChoose="OnChoose" OnRestart="OnRestart" />
</ReaderPresentation>

@code {
    [Parameter, EditorRequired] public AuthorSession Session { get; set; } = null!;
    [Parameter] public EventCallback<ChoiceView> OnChoose { get; set; }
    [Parameter] public EventCallback OnRestart { get; set; }
    private bool AtLimit => Session.Cursor >= StoryHistory.MaxChoices;
    private IReadOnlyList<HistoryFrame> Passages => [new(Session.Current)];
}
