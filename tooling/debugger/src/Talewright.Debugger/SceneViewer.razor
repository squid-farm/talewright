<section aria-label="Current passage" tabindex="0">
    <h3>@Session.Current.Scene @Session.Current.Title</h3>
    <DocumentView Document="Session.Current.Document" />
</section>
@if (AtLimit && !Session.Current.IsEnded)
{
    <p role="alert">This synthetic run reached the @StoryHistory.MaxChoices-command limit. Start a fresh scene playtest to continue.</p>
}
<StoryChoices Current="Session.Current" OnChoose="OnChoose" OnRestart="OnRestart" Busy="@(AtLimit && !Session.Current.IsEnded)" />

@code {
    [Parameter, EditorRequired] public AuthorSession Session { get; set; } = null!;
    [Parameter] public EventCallback<ChoiceView> OnChoose { get; set; }
    [Parameter] public EventCallback OnRestart { get; set; }
    private bool AtLimit => Session.Cursor >= StoryHistory.MaxChoices;
}
