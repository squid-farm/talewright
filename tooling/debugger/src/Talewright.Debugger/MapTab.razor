@using Microsoft.JSInterop
@using Talewright.Core.State
@inject IJSRuntime JS
@inject MapExportDialog ExportDialog
@implements IDisposable

<p>Every scene, divert and hub offer from the last successful compilation. Scenes the start scene can't reach through diverts and hub offers are drawn in a separate area on the right; reachability doesn't check whether conditions can be met.</p>
@if (_error is not null)
{
    <p role="alert" class="tw-error">@_error</p>
}
<div class="story-map" @ref="_host"></div>
@if (_previewError is not null)
{
    <p role="alert" class="tw-error">@_previewError</p>
}
@if (_preview is { } preview)
{
    <section class="map-preview" aria-label="Scene preview">
        <h3>Scene preview: @(preview.Title ?? preview.Scene)</h3>
        <p>Preview only, using @(preview.UsesCurrentRunState ? "the current playtest state" : "scene setup values"). Entry effects and skill checks are not run.</p>
        <DocumentView Document="preview.Document" />
        <h4>Available choices in this preview</h4>
        @if (preview.Choices.Count == 0)
        {
            <p>No choices are available in this preview.</p>
        }
        else
        {
            <ul>
                @foreach (var choice in preview.Choices)
                {
                    <li>@choice.Text</li>
                }
            </ul>
        }
    </section>
}
<div class="map-export-controls" aria-label="Export story map">
    <button type="button" disabled="@(!_mapReady || _exporting)" @onclick='() => ExportAsync("svg")'>Export SVG</button>
    <button type="button" disabled="@(!_mapReady || _exporting)" @onclick='() => ExportAsync("png")'>Export PNG</button>
    @if (_exportStatus is not null)
    {
        <p role="status">@_exportStatus</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public StoryDefinition Story { get; set; } = null!;
    [Parameter] public AuthorSession? Session { get; set; }
    [Parameter] public AuthorInspection? Inspection { get; set; }
    [Parameter, EditorRequired] public IGameStateView PreviewState { get; set; } = null!;

    private ElementReference _host;
    private StoryDefinition? _rendered;
    private MapView? _view;
    private AuthorInspection? _renderedInspection;
    private DotNetObjectReference<MapTab>? _reference;
    private SceneId? _selectedScene;
    private MapScenePreview? _preview;
    private string? _error;
    private string? _previewError;
    private string? _pendingExportPath;
    private string? _pendingExportFormat;
    private string? _exportStatus;
    private bool _mapReady;
    private bool _exporting;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Story, _rendered))
        {
            _mapReady = false;
            _view = MapView.Build(Story);
            if (_selectedScene is { } selected && !Story.Scenes.Any(scene => scene.Id == selected))
            {
                _selectedScene = null;
                _preview = null;
                _previewError = null;
            }
        }

        if (_selectedScene is { } sceneId)
            BuildPreview(sceneId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_view is not null && !ReferenceEquals(Story, _rendered))
        {
            _rendered = Story;
            _reference ??= DotNetObjectReference.Create(this);
            _renderedInspection = Inspection;
            try
            {
                await JS.InvokeVoidAsync("talewrightMap.render", _host, _view,
                    Session is null ? null : MapRunView.Build(Story, _view, Session), _reference);
                _error = null;
                _mapReady = true;
                StateHasChanged();
            }
            catch (JSException ex)
            {
                _error = $"The map could not be drawn: {ex.Message}";
                StateHasChanged();
            }
            return;
        }

        if (ReferenceEquals(Inspection, _renderedInspection) || _view is null)
            return;
        _renderedInspection = Inspection;
        try
        {
            await JS.InvokeVoidAsync("talewrightMap.updateRun", _host,
                Session is null ? null : MapRunView.Build(Story, _view, Session));
        }
        catch (JSException ex)
        {
            _error = $"The map route could not be updated: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ExportAsync(string format)
    {
        if (!_mapReady || _reference is null || _exporting)
            return;

        _exporting = true;
        _exportStatus = null;
        try
        {
            var path = await ExportDialog.ChoosePathAsync(format);
            if (path is null)
                return;

            _pendingExportPath = path;
            _pendingExportFormat = format;
            await JS.InvokeVoidAsync("talewrightMap.exportMap", _host, format, _reference,
                MapExportLimits.Padding, MapExportLimits.MaxPngDimension, MapExportLimits.MaxPngPixels);
            _exportStatus = $"Saved map to {path}";
        }
        catch (JSException ex)
        {
            _exportStatus = $"Map export failed: {ex.Message}";
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException)
        {
            _exportStatus = $"Map export failed: {ex.Message}";
        }
        finally
        {
            _pendingExportPath = null;
            _pendingExportFormat = null;
            _exporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public MapPngExportSize CheckPngExportSize(int width, int height) =>
        MapExportLimits.CheckPngSize(width, height);

    [JSInvokable]
    public async Task SaveMapExport(string format, IJSStreamReference reference)
    {
        if (_pendingExportPath is null || !string.Equals(format, _pendingExportFormat, StringComparison.Ordinal))
            throw new InvalidOperationException("There is no matching map export in progress.");

        await using var streamReference = reference;
        await using var contents = await streamReference.OpenReadStreamAsync(long.MaxValue);
        await MapExportFiles.SaveAsync(_pendingExportPath, format, contents);
    }

    [JSInvokable]
    public Task SelectScene(string scene)
    {
        if (scene == "END")
        {
            _selectedScene = null;
            _preview = null;
            _previewError = null;
            return InvokeAsync(StateHasChanged);
        }

        var definition = Story.Scenes.SingleOrDefault(candidate => candidate.Id.Value == scene)
            ?? throw new ArgumentException($"Unknown scene '{scene}'.", nameof(scene));
        _selectedScene = definition.Id;
        BuildPreview(definition.Id);
        return InvokeAsync(StateHasChanged);
    }

    private void BuildPreview(SceneId scene)
    {
        try
        {
            _preview = MapScenePreviewBuilder.Build(Story, scene, PreviewState, Session is not null);
            _previewError = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or KeyNotFoundException or ArithmeticException)
        {
            _preview = null;
            _previewError = $"The scene preview could not be rendered: {ex.Message}";
        }
    }

    public void Dispose()
    {
        _reference?.Dispose();
    }
}
