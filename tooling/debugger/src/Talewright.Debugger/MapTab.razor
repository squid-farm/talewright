@using Microsoft.JSInterop
@using Talewright.Core.State
@using Talewright.Talemark.Model
@inject IJSRuntime JS
@inject MapExportDialog ExportDialog
@implements IDisposable

<div class="story-map" @ref="_host">
    <div class="map-canvas-column">
        <MapToolbar Status="@_mapStatus" MapReady="_mapReady" Exporting="_exporting"
                    ExportStatus="@_exportStatus" OnFit="FitMap" OnFocusCurrentScene="FocusCurrentScene"
                    OnExportSvg='() => ExportAsync("svg")' OnExportPng='() => ExportAsync("png")' />
        @if (_error is not null)
        {
            <p role="alert" class="tw-error">@_error</p>
        }
        <div class="map-surface">
            <canvas @ref="_canvas" aria-hidden="true"></canvas>
            <div class="map-tooltip" @ref="_tooltip" aria-hidden="true" hidden></div>
        </div>
        @if (_view is not null)
        {
            <MapSceneNavigator @ref="_sceneNavigator" View="_view" SelectedNodeId="@_selectedNodeId"
                               OnFocus="FocusScene" OnBlur="BlurScene" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public StoryDefinition Story { get; set; } = null!;
    [Parameter] public MapView? View { get; set; }
    [Parameter] public AuthorSession? Session { get; set; }
    [Parameter] public AuthorInspection? Inspection { get; set; }
    [Parameter] public string? SelectedNodeId { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<string?> OnSelectScene { get; set; }

    private ElementReference _host;
    private ElementReference _canvas;
    private ElementReference _tooltip;
    private StoryDefinition? _rendered;
    private MapView? _view;
    private MapRunView? _run;
    private AuthorInspection? _renderedInspection;
    private DotNetObjectReference<MapTab>? _reference;
    private MapSceneNavigator? _sceneNavigator;
    private string? _selectedNodeId;
    private string? _error;
    private string _mapStatus = "Laying out the map…";
    private string? _pendingExportPath;
    private string? _pendingExportFormat;
    private string? _exportStatus;
    private bool _mapReady;
    private bool _exporting;
    private bool _renderedActive;
    private bool _selectionNeedsPublishing;

    protected override void OnParametersSet()
    {
        var storyChanged = !ReferenceEquals(Story, _rendered);
        if (storyChanged)
        {
            _mapReady = false;
            _view = View ?? MapView.Build(Story);
        }

        _run = Session is null || _view is null ? null : MapRunView.Build(Story, _view, Session);
        var selected = SelectedNodeId ?? _selectedNodeId;
        if (_rendered is null && selected is null)
            selected = _run?.CurrentScene ?? Story.Start.Value;
        if (selected is not null && (_view is null || !_view.Nodes.Any(node => node.Id == selected)))
            selected = null;
        if (_selectedNodeId != selected)
        {
            _selectedNodeId = selected;
            _selectionNeedsPublishing = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_view is not null && !ReferenceEquals(Story, _rendered))
        {
            _rendered = Story;
            _reference ??= DotNetObjectReference.Create(this);
            _renderedInspection = Inspection;
            try
            {
                await JS.InvokeVoidAsync("talewrightMap.render", _host, _canvas, _tooltip, _view, _run,
                    _selectedNodeId, _reference, Active);
                _error = null;
                _mapReady = true;
                _renderedActive = Active;
                StateHasChanged();
            }
            catch (JSException ex)
            {
                _error = $"The map could not be drawn: {ex.Message}";
                StateHasChanged();
            }
            await PublishSelectionAsync();
            return;
        }

        if (_view is null)
            return;

        if (_renderedActive != Active)
        {
            _renderedActive = Active;
            await InvokeMapAsync("talewrightMap.setActive", "The map focus could not be updated",
                Active, _run?.CurrentScene ?? Story.Start.Value);
        }

        if (!ReferenceEquals(Inspection, _renderedInspection))
        {
            _renderedInspection = Inspection;
            try
            {
                await JS.InvokeVoidAsync("talewrightMap.updateRun", _host, _run);
            }
            catch (JSException ex)
            {
                _error = $"The map route could not be updated: {ex.Message}";
                StateHasChanged();
            }
        }

        await PublishSelectionAsync();
    }

    private async Task ExportAsync(string format)
    {
        if (!_mapReady || _reference is null || _exporting)
            return;

        _exporting = true;
        _exportStatus = null;
        try
        {
            var path = await ExportDialog.ChoosePathAsync(format);
            if (path is null)
                return;

            _pendingExportPath = path;
            _pendingExportFormat = format;
            await JS.InvokeVoidAsync("talewrightMap.exportMap", _host, format, _reference,
                MapExportLimits.Padding, MapExportLimits.MaxPngDimension, MapExportLimits.MaxPngPixels);
            _exportStatus = $"Saved map to {path}";
        }
        catch (JSException ex)
        {
            _exportStatus = $"Map export failed: {ex.Message}";
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException)
        {
            _exportStatus = $"Map export failed: {ex.Message}";
        }
        finally
        {
            _pendingExportPath = null;
            _pendingExportFormat = null;
            _exporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public MapPngExportSize CheckPngExportSize(int width, int height) =>
        MapExportLimits.CheckPngSize(width, height);

    [JSInvokable]
    public async Task SaveMapExport(string format, IJSStreamReference reference)
    {
        if (_pendingExportPath is null || !string.Equals(format, _pendingExportFormat, StringComparison.Ordinal))
            throw new InvalidOperationException("There is no matching map export in progress.");

        await using var streamReference = reference;
        await using var contents = await streamReference.OpenReadStreamAsync(long.MaxValue);
        await MapExportFiles.SaveAsync(_pendingExportPath, format, contents);
    }

    [JSInvokable]
    public Task SelectScene(string scene) => SelectNode(scene);

    [JSInvokable]
    public Task SetMapStatus(string status)
    {
        _mapStatus = status;
        return InvokeAsync(StateHasChanged);
    }

    private async Task SelectNode(string scene)
    {
        if (scene != "END" && !Story.Scenes.Any(candidate => candidate.Id.Value == scene))
            throw new ArgumentException($"Unknown scene '{scene}'.", nameof(scene));

        _selectedNodeId = scene;
        _selectionNeedsPublishing = false;
        await InvokeAsync(StateHasChanged);
        await InvokeAsync(() => OnSelectScene.InvokeAsync(scene));
    }

    private async Task FocusScene(string scene)
    {
        await SelectNode(scene);
        await InvokeMapAsync("talewrightMap.setFocused", "The focused map scene could not be updated", scene);
    }

    private Task BlurScene(string scene) =>
        InvokeMapAsync("talewrightMap.clearFocused", "The focused map scene could not be updated", scene);

    public Task HighlightLine(string? line) =>
        InvokeMapAsync("talewrightMap.highlight", "The highlighted map line could not be updated", line);

    public async Task SelectDetailTarget(string scene)
    {
        if (_sceneNavigator is null)
            throw new InvalidOperationException("The map scene navigator is not available.");
        await _sceneNavigator.FocusSceneAsync(scene);
    }

    public Task SelectAndCenterScene(string scene) => FocusScene(scene);

    public Task FocusSelectedScene() =>
        _selectedNodeId is { } scene && _sceneNavigator is not null
            ? _sceneNavigator.FocusSceneAsync(scene)
            : Task.CompletedTask;

    private Task FitMap() => InvokeMapAsync("talewrightMap.fit", "The map could not be fitted");

    private Task FocusCurrentScene() =>
        InvokeMapAsync("talewrightMap.focusCurrent", "The current map scene could not be focused",
            _run?.CurrentScene ?? Story.Start.Value);

    private async Task InvokeMapAsync(string identifier, string error, params object?[] arguments)
    {
        try
        {
            var jsArguments = new object?[arguments.Length + 1];
            jsArguments[0] = _host;
            Array.Copy(arguments, 0, jsArguments, 1, arguments.Length);
            await JS.InvokeVoidAsync(identifier, jsArguments);
        }
        catch (JSException ex)
        {
            _error = $"{error}: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PublishSelectionAsync()
    {
        if (!_selectionNeedsPublishing)
            return;

        _selectionNeedsPublishing = false;
        await OnSelectScene.InvokeAsync(_selectedNodeId);
    }

    public string? CurrentSelection => _selectedNodeId;

    public void Dispose()
    {
        _reference?.Dispose();
    }
}
