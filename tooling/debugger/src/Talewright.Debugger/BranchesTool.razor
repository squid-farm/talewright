<section aria-label="Branch explanations">
    <h2 class="visually-hidden">Branch explanations</h2>
    <p class="tool-note">Historical results at recorded event offsets, not reevaluations of current state. Null results are not evaluated. Scene-step decisions include their source location.</p>
    <div class="tool-filters">
        <label>Filter decisions <input aria-label="Filter decisions" @bind="_decisionFilter" @bind:event="oninput" /></label>
        <label>Decision kind <select aria-label="Decision kind" @bind="_kind">
            <option value="">All</option>
            @foreach (var kind in Enum.GetValues<DecisionKind>()) { <option value="@kind">@kind</option> }
        </select></label>
    </div>
    @if (!Inspection.DecisionsCaptured)
    {
        <p>Decision recording unavailable for this run.</p>
    }
    <p class="tool-note">Showing the most recent 100 matching decisions. Filter by subject or scene ID.</p>
    <DecisionList Inspection="Inspection" Filter="@_decisionFilter" Kind="SelectedKind"
                  Story="Story" ExpandedDecision="FocusedDecision" OnInspectSelection="OnInspectSelection" />
</section>

@code {
    [Parameter, EditorRequired] public AuthorInspection Inspection { get; set; } = null!;
    [Parameter] public StoryDefinition? Story { get; set; }
    [Parameter] public RuleDecision? FocusedDecision { get; set; }
    [Parameter] public int FocusRevision { get; set; }
    [Parameter] public EventCallback<InspectorSelection> OnInspectSelection { get; set; }
    private string _decisionFilter = "";
    private string _kind = "";
    private DecisionKind? SelectedKind => Enum.TryParse<DecisionKind>(_kind, out var kind) ? kind : null;
    private RuleDecision? _previousDecision;
    private int _previousFocusRevision;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_previousDecision, FocusedDecision) || _previousFocusRevision != FocusRevision)
        {
            _previousDecision = FocusedDecision;
            _previousFocusRevision = FocusRevision;
            if (FocusedDecision is { } decision)
                _decisionFilter = decision.Subject;
        }
    }
}
