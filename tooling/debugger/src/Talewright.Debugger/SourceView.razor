<section class="source-view" aria-label="Accepted Talemark source">
    <h3 class="visually-hidden">Accepted Talemark source</h3>
    @if (Pending)
    {
        <p role="status" class="source-notice">Disk changes pending compilation/adoption. Accepted source remains displayed.</p>
    }
    @if (Rejected || RestartRequired)
    {
        <p role="status" class="source-notice">Disk source is stale or restart-required, not adopted. This view still shows accepted source.</p>
    }
    @if (Source is not { } source)
    {
        <p role="status" class="source-empty">Source mapping unavailable for this passage (for example, a C#-defined scene or no scene). No source is guessed.</p>
    }
    else
    {
        <div class="source-bar">
            <p class="source-location" title="@source.Range.File">Accepted file: @source.Range.File. Scene @source.Scene source range: lines @source.Range.StartLine to @source.Range.EndLine (inclusive).</p>
            <span class="source-page" aria-hidden="true">@_firstLine–@LastLine of @_lines.Length</span>
            <button type="button" @onclick="ShowScene">
                @(FollowingCurrentScene ? "Go to current scene source" : "Go to selected scene source")
            </button>
            <button type="button" disabled="@(_firstLine == 1)" @onclick="Previous">Previous source lines</button>
            <button type="button" disabled="@(LastLine == _lines.Length)" @onclick="Next">Next source lines</button>
        </div>
        <div @key="_navigationRevision" class="source-window" tabindex="0" aria-label="Read-only accepted source lines">
            <table class="source-lines">
                <caption class="visually-hidden">Showing accepted lines @_firstLine to @LastLine of @_lines.Length</caption>
                <thead><tr><th scope="col">Line</th><th scope="col">Talemark source</th></tr></thead>
                <tbody>
                    @for (var line = _firstLine; line <= LastLine; line++)
                    {
                        <tr class="@LineClass(source, line)"
                            aria-current="@(line == source.HighlightLine ? "true" : null)">
                            <th scope="row">@line</th><td><code>@_lines[line - 1]</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter] public AcceptedSceneSource? Source { get; set; }
    [Parameter] public bool Pending { get; set; }
    [Parameter] public bool Rejected { get; set; }
    [Parameter] public bool RestartRequired { get; set; }
    [Parameter] public bool FollowingCurrentScene { get; set; } = true;
    private const int PageSize = 100;
    private AcceptedSceneSource? _displayed;
    private string[] _lines = [];
    private int _firstLine = 1;
    private long _navigationRevision;
    private int LastLine => Math.Min(_firstLine + PageSize - 1, _lines.Length);

    protected override void OnParametersSet()
    {
        if (Source == _displayed)
        {
            return;
        }
        _displayed = Source;
        _lines = Source?.Text.ReplaceLineEndings("\n").Split('\n') ?? [];
        ShowScene();
    }

    private void ShowScene() => Navigate(Math.Max(1, (Source?.Range.StartLine ?? 1) - 3));
    private void Previous() => Navigate(Math.Max(1, _firstLine - PageSize));
    private void Next() => Navigate(Math.Min(_lines.Length, _firstLine + PageSize));

    private void Navigate(int firstLine)
    {
        _firstLine = firstLine;
        ++_navigationRevision;
    }

    private static string? LineClass(AcceptedSceneSource source, int line)
    {
        var isScene = line >= source.Range.StartLine && line <= source.Range.EndLine;
        var isChoice = line == source.HighlightLine;
        return (isScene, isChoice) switch
        {
            (true, true) => "source-scene source-choice",
            (true, false) => "source-scene",
            (false, true) => "source-choice",
            _ => null,
        };
    }
}
