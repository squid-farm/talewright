<div class="scene-picker">
    <label class="scene-search"><span class="visually-hidden">Search scenes</span><input type="search" aria-label="Search scenes" placeholder="Filter scenes by ID or title" @bind="_sceneSearch" @bind:event="oninput" /></label>
    <p class="scene-count">@Model.FindScenes(_sceneSearch).Count() matching scenes. Showing up to 50; narrow the search or enter an exact ID.</p>
    <ul class="scene-list" aria-label="Matching scenes">
        @foreach (var scene in Model.FindScenes(_sceneSearch).Take(50))
        {
            var selected = scene.Id.Value == Model.Target;
            <li><button type="button" class="@(selected ? "selected" : null)" aria-current="@(selected ? "true" : null)" @onclick="() => OnSelect.InvokeAsync(scene.Id.Value)"><span class="visually-hidden">@("Select ")</span><code>@scene.Id</code>@(" " + scene.Title)</button></li>
        }
    </ul>
</div>

@code {
    [Parameter, EditorRequired] public WorkbenchModel Model { get; set; } = null!;
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    private string _sceneSearch = "";
}
