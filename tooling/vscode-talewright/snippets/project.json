{
  "name": "talewright-snippets",
  "implicitDependencies": ["talewright-snippet-contract-source"],
  "tags": ["type:contract", "area:editor"],
  "targets": {
    "compiler-contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [{"projects": ["Talewright.Tale.Tests"], "target": "build:release"}],
      "options": {
        "command": "dotnet test tests/Talewright.Tale.Tests -c Release --no-build --no-restore --filter FullyQualifiedName~EditorSnippetTests"
      }
    }
  }
}
