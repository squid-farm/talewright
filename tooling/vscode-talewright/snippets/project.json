{
  "name": "talewright-snippets",
  "implicitDependencies": ["talewright-snippet-contract-source"],
  "tags": ["type:contract", "area:editor"],
  "namedInputs": {
    "default": ["sharedGlobals", "{projectRoot}/**/*", "editorWorkflow"]
  },
  "targets": {
    "compiler-contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [{"projects": ["Talewright.Talemark.Tests"], "target": "build:release"}],
      "options": {
        "command": "dotnet test engine/tests/Talewright.Talemark.Tests -c Release --no-build --no-restore --filter FullyQualifiedName~EditorSnippetTests"
      }
    }
  }
}
