{
  "name": "talewright-editor",
  "implicitDependencies": ["Story", "Talewright.Tale", "Talewright.Tale.Tests", "Talewright.LanguageServer", "talewright-snippets"],
  "tags": ["type:tooling", "area:editor"],
  "namedInputs": {
    "default": ["sharedGlobals", "{projectRoot}/**/*", "editorWorkflow"],
    "documentedManifests": [
      "{workspaceRoot}/docs/reference/tale-syntax.md",
      "{workspaceRoot}/docs/guide/first-story.md",
      "{workspaceRoot}/docs/guide/debugger-test-plan.md",
      "{workspaceRoot}/docs/guide/writing-stories.md"
    ]
  },
  "targets": {
    "compiler-contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default", "editorWorkflow", "documentedManifests"],
      "dependsOn": [{"projects": ["Talewright.Tale.Tests"], "target": "build:release"}],
      "options": {
        "command": "dotnet test engine/tests/Talewright.Tale.Tests -c Release --no-build --no-restore --filter FullyQualifiedName~EditorManifestSchemaTests"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "cache": false,
      "inputs": ["default", "^default", "documentedManifests"],
      "options": {
        "command": "npm test",
        "args": [],
        "cwd": "tooling/vscode-talewright"
      }
    },
    "package-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npm run package && npm run test:package",
        "cwd": "tooling/vscode-talewright"
      }
    },
    "editor-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["package-check", {"projects": ["Talewright.LanguageServer"], "target": "build:release"}],
      "cache": false,
      "options": {
        "command": "xvfb-run -a npm run test:editor",
        "cwd": "tooling/vscode-talewright"
      }
    }
  }
}
