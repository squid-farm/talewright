{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Talemark",
  "scopeName": "text.tale",
  "patterns": [
    {
      "match": "^\\s*(//).*$",
      "name": "comment.line.double-slash.tale",
      "captures": {"1": {"name": "punctuation.definition.comment.tale"}}
    },
    {
      "match": "^\\s*(@continues)\\s*$",
      "captures": {"1": {"name": "keyword.control.metadata.tale"}}
    },
    {
      "match": "^\\s*(@choice-label)(?=\\s|$)",
      "captures": {"1": {"name": "keyword.control.metadata.tale"}}
    },
    {
      "match": "^\\s*(===)\\s*(.*)$",
      "captures": {
        "1": {"name": "punctuation.definition.heading.tale"},
        "2": {"name": "entity.name.section.tale"}
      }
    },
    {
      "match": "^\\s*(?:\\*[^\\r\\n]*?)?(->)\\s*([A-Za-z_][A-Za-z0-9_.-]*)?",
      "captures": {
        "1": {"name": "keyword.control.divert.tale"},
        "2": {"name": "entity.name.section.target.tale"}
      }
    },
    {"include": "#inline"}
  ],
  "repository": {
    "string": {
      "begin": "\"",
      "end": "\"|(?=$)",
      "name": "string.quoted.double.tale",
      "patterns": [
        {"match": "\\\\[\"\\\\]", "name": "constant.character.escape.tale"}
      ]
    },
    "template": {
      "begin": "(\\{)",
      "beginCaptures": {"1": {"name": "punctuation.section.template.begin.tale"}},
      "end": "(\\})|(?=$)",
      "endCaptures": {"1": {"name": "punctuation.section.template.end.tale"}},
      "name": "meta.template.tale",
      "patterns": [{"include": "#inline"}]
    },
    "inline": {
      "patterns": [
        {"match": "\\\\[{}*_]", "name": "constant.character.escape.tale"},
        {"include": "#string"},
        {"include": "#template"},
        {
          "begin": "(?<![\\p{L}\\p{N}*])\\*\\*(?!\\*)(?=\\S)",
          "end": "(?<!\\s)\\*\\*(?![\\p{L}\\p{N}*])|(?=$)",
          "name": "markup.bold.markdown",
          "patterns": [{"include": "#inline"}]
        },
        {
          "begin": "(?<![\\p{L}\\p{N}_])__(?!_)(?=\\S)",
          "end": "(?<!\\s)__(?![\\p{L}\\p{N}_])|(?=$)",
          "name": "markup.bold.markdown",
          "patterns": [{"include": "#inline"}]
        },
        {
          "begin": "(?<![\\p{L}\\p{N}*])\\*(?!\\*)(?=\\S)",
          "end": "(?<!\\s)\\*(?![\\p{L}\\p{N}*])|(?=$)",
          "name": "markup.italic.markdown",
          "patterns": [{"include": "#inline"}]
        },
        {
          "begin": "(?<![\\p{L}\\p{N}_])_(?!_)(?=\\S)",
          "end": "(?<!\\s)_(?![\\p{L}\\p{N}_])|(?=$)",
          "name": "markup.italic.markdown",
          "patterns": [{"include": "#inline"}]
        }
      ]
    }
  }
}
