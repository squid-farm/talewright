{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/squid-farm/talewright/main/tooling/vscode-talewright/schemas/story.schema.json",
  "title": "Talewright story manifest (story.talewright.yaml)",
  "description": "Structural validation and authoring help for a Talewright story manifest. Story-specific identifiers and Tale expressions are checked by the Talewright compiler.",
  "type": "object",
  "required": ["id", "title", "start", "characters"],
  "properties": {
    "id": {
      "$ref": "#/definitions/identifier",
      "description": "Unique identifier for this story."
    },
    "title": {
      "$ref": "#/definitions/nonEmptyString",
      "description": "Title shown to players."
    },
    "version": {
      "type": "string",
      "default": "0.0.0",
      "description": "Author-defined story version. Defaults to 0.0.0."
    },
    "start": {
      "$ref": "#/definitions/identifier",
      "description": "ID of the scene where play begins. The compiler checks that this scene exists."
    },
    "randomness": {
      "type": "string",
      "enum": ["off", "checks-only"],
      "default": "checks-only",
      "description": "Whether random rolls are disabled or used only for skill checks."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional non-negative integer seed. The compiler additionally enforces its unsigned 64-bit limit."
    },
    "undo": {
      "$ref": "#/definitions/booleanScalar",
      "default": true,
      "description": "Whether players can navigate backward and forward. Saves remain available when false."
    },
    "creation": {
      "$ref": "#/definitions/creation",
      "description": "Optional player character creation choices."
    },
    "ruleset": {
      "$ref": "#/definitions/ruleset",
      "description": "Optional ruleset configuration. Defaults to the generic ruleset."
    },
    "characters": {
      "type": "object",
      "required": ["player"],
      "description": "Characters keyed by their story-specific IDs. The player character is required.",
      "propertyNames": {
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "$ref": "#/definitions/character"
      }
    },
    "factions": {
      "type": "object",
      "description": "Factions keyed by story-specific IDs.",
      "propertyNames": {
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "$ref": "#/definitions/faction"
      }
    },
    "items": {
      "type": "object",
      "description": "Items keyed by story-specific IDs.",
      "propertyNames": {
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "$ref": "#/definitions/itemValue"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/identifier"
      },
      "description": "Optional flags to declare before any Tale effect sets them."
    },
    "vars": {
      "$ref": "#/definitions/integerMap",
      "description": "Optional integer variables keyed by story-specific IDs."
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/trigger"
      },
      "description": "Optional story-wide condition/effect triggers."
    }
  },
  "additionalProperties": false,
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.-][A-Za-z0-9_]+)*$",
      "description": "ASCII identifier: start with a letter or _, then use letters, digits, _, or single . and - separators."
    },
    "integer": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "booleanScalar": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "pattern": "^(true|false)$",
          "description": "Quoted true/false values are also accepted by the compiler."
        }
      ]
    },
    "booleanOrYesNoScalar": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": ["true", "false", "yes", "no"],
          "description": "The compiler also accepts the lowercase yes/no scalar forms."
        }
      ]
    },
    "integerMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/identifier"
      },
      "additionalProperties": {
        "$ref": "#/definitions/integer"
      }
    },
    "statMap": {
      "$ref": "#/definitions/integerMap",
      "description": "Stats keyed by ruleset stat IDs. The compiler checks each ID against the selected ruleset."
    },
    "ruleset": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/definitions/identifier",
          "default": "generic",
          "description": "Built-in rulesets include generic and none; a C# story project may register another ruleset."
        },
        "disable": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/identifier"
          },
          "description": "Stat IDs to remove from the base ruleset."
        },
        "stats": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/statDefinition"
          },
          "description": "Additional or replacement stat definitions."
        }
      },
      "additionalProperties": false
    },
    "statDefinition": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier",
          "description": "Stat ID used by characters, items, and Tale expressions."
        },
        "name": {
          "type": "string",
          "description": "Display name. Defaults to the stat ID."
        },
        "category": {
          "type": "string",
          "enum": ["attribute", "skill", "resource", "progression", "custom"],
          "default": "custom",
          "description": "Stat category."
        },
        "min": {
          "$ref": "#/definitions/integer",
          "default": 0,
          "description": "Inclusive minimum. Defaults to 0."
        },
        "max": {
          "$ref": "#/definitions/integer",
          "default": 2147483647,
          "description": "Inclusive maximum. Defaults to the largest supported 32-bit integer."
        },
        "default": {
          "$ref": "#/definitions/integer",
          "description": "Initial stat value. Defaults to min, or 0 when min is omitted."
        }
      },
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "required": ["first-name"],
      "properties": {
        "first-name": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "last-name": {
          "type": "string"
        },
        "pronouns": {
          "$ref": "#/definitions/pronouns"
        },
        "stats": {
          "$ref": "#/definitions/statMap"
        },
        "inventory": {
          "$ref": "#/definitions/inventory"
        },
        "plural": {
          "$ref": "#/definitions/booleanOrYesNoScalar",
          "default": false,
          "description": "Whether this character uses plural grammar."
        }
      },
      "additionalProperties": false
    },
    "pronouns": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["she", "he", "they", "it"],
          "description": "A built-in pronoun set."
        },
        {
          "$ref": "#/definitions/customPronouns"
        }
      ]
    },
    "customPronouns": {
      "type": "object",
      "required": ["subject", "object", "possessive", "possessive-pronoun", "reflexive"],
      "properties": {
        "subject": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "object": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "possessive": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "possessive-pronoun": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "reflexive": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "plural": {
          "$ref": "#/definitions/booleanOrYesNoScalar",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "inventory": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/identifier"
          },
          "description": "List of item IDs; each listed item has quantity one."
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/identifier"
          },
          "additionalProperties": {
            "$ref": "#/definitions/integer"
          },
          "description": "Item IDs mapped to quantities."
        }
      ]
    },
    "itemValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Short form: the item's display name."
        },
        {
          "$ref": "#/definitions/item"
        }
      ]
    },
    "item": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name. Defaults to the item ID."
        },
        "modifiers": {
          "$ref": "#/definitions/statMap",
          "description": "Stat modifiers while the item is held."
        }
      },
      "additionalProperties": false
    },
    "faction": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name. Defaults to the faction ID."
        },
        "standing": {
          "$ref": "#/definitions/integer",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "creation": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/booleanScalar",
          "default": false,
          "description": "Allow the player to edit their first and last names."
        },
        "pronouns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["she", "he", "they", "it"]
          },
          "description": "Distinct built-in pronoun choices; the first is the default."
        },
        "stats": {
          "type": "object",
          "maxProperties": 32,
          "description": "Selectable values by ruleset stat ID. Each list must contain 1 to 100 distinct, in-range integers.",
          "propertyNames": {
            "$ref": "#/definitions/identifier"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/integer"
            }
          }
        },
        "presets": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "allOf": [
              {
                "$ref": "#/definitions/identifier"
              },
              {
                "maxLength": 80
              }
            ]
          },
          "description": "Named starting-stat presets. A preset's stats must respect ruleset bounds and selectable choices.",
          "additionalProperties": {
            "$ref": "#/definitions/preset"
          }
        }
      },
      "additionalProperties": false
    },
    "preset": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "Display name. Defaults to the preset ID."
        },
        "stats": {
          "$ref": "#/definitions/statMap"
        }
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": ["id", "when", "do"],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "when": {
          "$ref": "#/definitions/nonEmptyString",
          "description": "Tale predicate that activates the trigger."
        },
        "do": {
          "$ref": "#/definitions/nonEmptyString",
          "description": "Tale effect applied when the trigger activates."
        },
        "once": {
          "$ref": "#/definitions/booleanOrYesNoScalar",
          "default": false,
          "description": "When true, the trigger fires at most once."
        }
      },
      "additionalProperties": false
    }
  }
}
