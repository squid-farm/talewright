{
  "name": "talewright",
  "displayName": "Talewright",
  "description": "Tale highlighting, snippets, story.talewright.yaml schema, and shared live compiler diagnostics.",
  "version": "0.1.0",
  "publisher": "squid-farm",
  "license": "MPL-2.0",
  "main": "./dist/extension.cjs",
  "activationEvents": ["onLanguage:tale", "onLanguage:yaml", "workspaceContains:**/story.talewright.yaml"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Live validation launches a configured local executable only in trusted workspaces.",
      "restrictedConfigurations": ["talewright.languageServer.command", "talewright.languageServer.args"]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/squid-farm/talewright.git",
    "directory": "tooling/vscode-talewright"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "configuration": {
      "title": "Talewright",
      "properties": {
        "talewright.languageServer.enabled": { "type": "boolean", "default": true, "description": "Enable shared live diagnostics. Reload the window after changing settings." },
        "talewright.languageServer.command": { "type": "string", "default": "talewright-lsp", "description": "Installed language-server executable. Never installed or built automatically." },
        "talewright.languageServer.args": { "type": "array", "items": { "type": "string" }, "default": ["--stdio"], "description": "Server arguments; for a local build use dotnet with the server DLL followed by --stdio." },
        "talewright.languageServer.metadataPath": { "type": "string", "default": "", "description": "Explicit data-only authoring metadata file, absolute or relative to each story root." },
        "talewright.languageServer.requiresProjectMetadata": { "type": "boolean", "default": false, "description": "Require exported project registrations, including for external/nested C# projects. Missing metadata produces TW5001." }
      }
    },
    "configurationDefaults": {
      "[tale]": {
        "editor.autoClosingBrackets": "never",
        "editor.autoClosingQuotes": "never"
      }
    },
    "languages": [
      {
        "id": "tale",
        "aliases": [
          "Tale",
          "tale"
        ],
        "extensions": [
          ".tale"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tale",
        "scopeName": "text.tale",
        "path": "./syntaxes/tale.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tale",
        "path": "./snippets/tale.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": ["*.talewright.yaml"],
        "url": "./schemas/story.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "esbuild extension.cjs --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:editor": "node tests/run-editor.mjs",
    "package": "npm run build && node tests/package.mjs",
    "test:package": "node tests/check-package.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "ajv": "^8.20.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "yaml": "^2.9.1"
  }
}
