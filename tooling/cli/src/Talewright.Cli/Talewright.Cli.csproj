<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>talewright</ToolCommandName>
    <IsPackable>true</IsPackable>
    <Description>Validate, lint, run, debug and publish Talewright stories.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Talewright.Cli.Tests" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
    <ProjectReference Include="../../../authoring/src/Talewright.Authoring/Talewright.Authoring.csproj" />
    <ProjectReference Include="../../../../engine/src/Talewright.Talemark/Talewright.Talemark.csproj" />
    <ProjectReference Include="../../../../engine/src/Talewright.Runtime/Talewright.Runtime.csproj" />
    <ProjectReference Include="../../../../player/src/Talewright.Player/Talewright.Player.csproj" />
    <ProjectReference Include="../../../debugger/src/Talewright.Debugger/Talewright.Debugger.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Pack="false" Include="../../../../apps/web/*.cs;../../../../apps/web/*.razor;../../../../apps/web/*.csproj"
             Link="publish-assets/web/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Pack="false" Include="../../../../apps/web/wwwroot/**"
             Link="publish-assets/web/wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Pack="false" Include="../../../../apps/desktop/*.cs;../../../../apps/desktop/*.razor;../../../../apps/desktop/*.csproj;../../../../apps/desktop/THIRD-PARTY-NOTICES.txt"
             Link="publish-assets/desktop/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Pack="false" Include="../../../../apps/desktop/wwwroot/**"
             Link="publish-assets/desktop/wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Pack="false" Include="../../../../player/src/Talewright.Player/wwwroot/**"
             Link="publish-assets/player/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Pack="false" Include="../../../../player/src/Talewright.Player/Components/*.razor.js"
             Link="publish-assets/player/Components/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Pack="false" Include="../../../../LICENSE" Link="publish-assets/ENGINE-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Pack="false" Update="PublishAssets/*" Link="publish-assets/launchers/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="PublishAssets/standalone/**" />
    <Compile Remove="PublishAssets/standalone/**/*.cs" />
    <None Pack="false" Include="PublishAssets/standalone/**" Link="publish-assets/standalone/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
