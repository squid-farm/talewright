<Project>
  <PropertyGroup>
    <TalewrightLibraryTargetFrameworks Condition="'$(TalewrightLibraryTargetFrameworks)' == ''">net8.0;net9.0;net10.0</TalewrightLibraryTargetFrameworks>
    <!-- Engine libraries multi-target; everything else (hosts, samples) stays on the latest TFM. -->
    <TargetFrameworks Condition="'$(TalewrightMultiTarget)' == 'true' And '$(TargetFrameworks)' == ''">$(TalewrightLibraryTargetFrameworks)</TargetFrameworks>
    <TargetFramework Condition="'$(TalewrightMultiTarget)' != 'true'">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public APIs are documented, but missing XML comments are not a build failure. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>Talewright contributors</Authors>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Description>A stat-driven, branching narrative RPG engine for .NET.</Description>
    <RepositoryUrl>https://github.com/squid-farm/talewright</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/squid-farm/talewright</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- Items evaluate after every project property, so this sees each project's own IsPackable. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)apps/web/wwwroot/icon-192.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>
