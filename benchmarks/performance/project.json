{
  "name": "talewright-performance-tooling",
  "tags": ["type:tooling", "area:testing"],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "testWorkflow", "{workspaceRoot}/.github/workflows/performance.yml"],
      "options": {
        "command": "python3 -m unittest discover -s benchmarks/performance -p 'test_*.py' -v"
      }
    }
  }
}
