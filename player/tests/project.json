{
  "name": "talewright-e2e-runner",
  "tags": ["type:tooling", "area:testing"],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "{workspaceRoot}/player/src/Talewright.Player/**/*.js",
        "testWorkflow"
      ],
      "options": {
        "command": "node --test player/tests/*.test.mjs"
      }
    }
  }
}
