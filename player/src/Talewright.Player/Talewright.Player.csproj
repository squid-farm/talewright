<Project Sdk="Microsoft.NET.Sdk.Razor">
  <ItemGroup>
    <InternalsVisibleTo Include="Talewright.Player.E2E.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>The Blazor player for Talewright, including the headless engine as a dependency.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../engine/src/Talewright.Runtime/Talewright.Runtime.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../../packaging/Talewright/Talewright.csproj" />
  </ItemGroup>

</Project>
