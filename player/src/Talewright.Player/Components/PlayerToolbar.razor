@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Talewright.Player.Preferences.PlayerPreferencesStore Preferences

<header class="tw-bar" aria-label="Player toolbar" @ref="_bar">
    <h1>@Title</h1>
    <div class="tw-bar-actions">
        @if (OnHistory.HasDelegate)
        {
            <button type="button" class="tw-link tw-history-trigger" disabled="@Busy"
                    aria-expanded="@(ReadingHistory ? "true" : "false")" @onclick="OnHistory">History</button>
        }
        @if (UndoEnabled)
        {
            <button type="button" class="tw-link" disabled="@(Busy || ReadingHistory || !CanBack)" @onclick="OnBack">Back</button>
            <button type="button" class="tw-link" disabled="@(Busy || ReadingHistory || !CanForward)" @onclick="OnForward">Forward</button>
        }
        @if (CanSave)
        {
            <button type="button" class="tw-link tw-quick-save" disabled="@(Busy || ReadingHistory)" @onclick="OnQuickSave">Quick Save</button>
            <button type="button" class="tw-link tw-saves-trigger" disabled="@(Busy || ReadingHistory)" @onclick="OnSavedGames">Saves</button>
        }
        <div class="tw-overflow">
            <button type="button" class="tw-link" aria-expanded="@(_menuOpen ? "true" : "false")"
                    disabled="@(Busy || ReadingHistory || !_initialized)" @onclick="ToggleMenu" @ref="_toggle">More actions</button>
            <div class="tw-overflow-actions" hidden="@(!_menuOpen)" @ref="_menu">
                <button type="button" class="tw-link" disabled="@(Busy || ReadingHistory)" @onclick="OpenSettings">Settings</button>
                <button type="button" class="tw-link" disabled="@(Busy || ReadingHistory)" @onclick="ConfirmRestart">Restart</button>
                @if (OnExit.HasDelegate)
                {
                    <button type="button" class="tw-link" disabled="@(Busy || ReadingHistory)" @onclick="Exit">Library</button>
                }
            </div>
        </div>
    </div>
    @if (Message is not null)
    {
        <p class="tw-toolbar-feedback @(Error ? "tw-error" : "tw-save-status")"
           role="@(Error ? "alert" : "status")">@Message</p>
    }
</header>

<dialog class="tw-settings" aria-labelledby="tw-settings-heading" @ref="_settings">
    <h2 id="tw-settings-heading">Settings</h2>
    <label for="tw-theme">Theme</label>
    <select id="tw-theme" value="@_theme" @onchange="ChangeTheme">
        <option value="@PlayerTheme.System">System</option>
        <option value="@PlayerTheme.Light">Light</option>
        <option value="@PlayerTheme.Dark">Dark</option>
    </select>
    @if (Preferences.Warning is not null)
    {
        <p class="tw-error" role="status">@Preferences.Warning</p>
    }
    <div class="tw-settings-actions">
        <button type="button" class="tw-choice" @onclick="CloseSettings">Close settings</button>
    </div>
</dialog>

<dialog class="tw-confirm" aria-label="Restart story?" @ref="_confirmation">
    <h2>Restart story?</h2>
    <p>This discards your current playthrough. Saved games are kept.</p>
    <div class="tw-confirm-actions">
        <button type="button" class="tw-choice" @onclick="CancelRestart" autofocus>Keep playing</button>
        <button type="button" class="tw-choice" @onclick="Restart">Restart story</button>
    </div>
</dialog>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool UndoEnabled { get; set; }
    [Parameter] public bool CanBack { get; set; }
    [Parameter] public bool CanForward { get; set; }
    [Parameter] public bool CanSave { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnForward { get; set; }
    [Parameter] public EventCallback OnSavedGames { get; set; }
    [Parameter] public EventCallback OnQuickSave { get; set; }
    [Parameter] public EventCallback OnRestart { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }
    [Parameter] public bool ReadingHistory { get; set; }
    [Parameter] public EventCallback OnHistory { get; set; }

    private ElementReference _bar, _toggle, _menu, _settings, _confirmation;
    private IJSObjectReference? _module;
    private bool _menuOpen;
    private bool _initialized;
    private bool _focusMenu;
    private PlayerTheme _theme = PlayerTheme.System;

    protected override void OnInitialized() => _theme = Preferences.Current.Theme;

    protected override void OnParametersSet()
    {
        if (ReadingHistory)
        {
            _menuOpen = false;
            _focusMenu = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Talewright.Player/Components/PlayerToolbar.razor.js");
            await _module.InvokeVoidAsync("initialize", _bar, _toggle, _menu, _confirmation, _settings);
            _initialized = true;
            StateHasChanged();
        }
        if (_focusMenu)
        {
            _focusMenu = false;
            await _module!.InvokeVoidAsync("focusMenu", _menu);
        }
    }

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
        _focusMenu = _menuOpen;
    }

    private async Task ConfirmRestart()
    {
        _menuOpen = false;
        await _module!.InvokeVoidAsync("openConfirmation", _confirmation);
    }

    private async Task OpenSettings()
    {
        _menuOpen = false;
        await _module!.InvokeVoidAsync("openSettings", _menu, _settings);
    }

    private async Task CloseSettings() =>
        await _module!.InvokeVoidAsync("closeSettings", _settings, _toggle);

    private async Task ChangeTheme(ChangeEventArgs args)
    {
        if (!Enum.TryParse<PlayerTheme>(args.Value?.ToString(), out var theme) || !Enum.IsDefined(theme))
        {
            throw new InvalidOperationException($"Unknown theme selection '{args.Value}'.");
        }

        await Preferences.SetThemeAsync(theme);
        _theme = theme;
    }

    private async Task CancelRestart() =>
        await _module!.InvokeVoidAsync("closeConfirmation", _confirmation, _toggle);

    private async Task Restart()
    {
        await CancelRestart();
        await OnRestart.InvokeAsync();
    }

    private async Task Exit()
    {
        _menuOpen = false;
        await OnExit.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", _bar);
            await _module.DisposeAsync();
        }
    }
}
