@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Talewright.Player.Preferences.PlayerPreferencesStore Preferences

<dialog class="tw-settings" aria-labelledby="tw-settings-heading" @ref="_dialog">
    <h2 id="tw-settings-heading">Settings</h2>
    <label for="tw-theme">Theme</label>
    <select id="tw-theme" value="@_theme" @onchange="ChangeTheme">
        <option value="@PlayerTheme.System">System</option>
        <option value="@PlayerTheme.Light">Light</option>
        <option value="@PlayerTheme.Dark">Dark</option>
    </select>
    <label for="tw-text-size">Text size</label>
    <select id="tw-text-size" value="@_textSizePercent" @onchange="ChangeTextSize">
        @foreach (var textSize in PlayerPreferences.SupportedTextSizes)
        {
            <option value="@textSize">@textSize%</option>
        }
    </select>
    <label class="tw-settings-toggle">
        <input type="checkbox" checked="@_hideMechanicalNotes" @onchange="ChangeHideMechanicalNotes" />
        Hide mechanical notes
    </label>
    <label for="tw-reading-width">Reading width</label>
    <select id="tw-reading-width" value="@ReadingWidthValue(_readingWidth)" @onchange="ChangeReadingWidth">
        @foreach (var readingWidth in PlayerPreferences.SupportedReadingWidths)
        {
            <option value="@ReadingWidthValue(readingWidth)">@readingWidth</option>
        }
    </select>
    <label for="tw-line-spacing">Line spacing</label>
    <select id="tw-line-spacing" value="@LineSpacingValue(_lineSpacing)" @onchange="ChangeLineSpacing">
        @foreach (var lineSpacing in PlayerPreferences.SupportedLineSpacings)
        {
            <option value="@LineSpacingValue(lineSpacing)">@lineSpacing</option>
        }
    </select>
    <label for="tw-reduced-motion">Reduced motion</label>
    <select id="tw-reduced-motion" value="@ReducedMotionValue(_reducedMotion)" @onchange="ChangeReducedMotion">
        @foreach (var reducedMotion in PlayerPreferences.SupportedReducedMotions)
        {
            <option value="@ReducedMotionValue(reducedMotion)">
                @(reducedMotion == PlayerReducedMotion.System ? "System" : "Reduce")
            </option>
        }
    </select>
    @if (Preferences.Warning is not null)
    {
        <p class="tw-error" role="status">@Preferences.Warning</p>
    }
    <div class="tw-settings-actions">
        <button type="button" class="tw-choice" @onclick="CloseSettings">Close settings</button>
    </div>
    <BuildIdentity />
</dialog>

@code {
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private ElementReference? _returnFocus;
    private PlayerTheme _theme = PlayerTheme.System;
    private int _textSizePercent = PlayerPreferences.DefaultTextSizePercent;
    private PlayerReadingWidth _readingWidth = PlayerReadingWidth.Normal;
    private PlayerLineSpacing _lineSpacing = PlayerLineSpacing.Normal;
    private PlayerReducedMotion _reducedMotion = PlayerReducedMotion.System;
    private bool _hideMechanicalNotes;

    protected override void OnInitialized()
    {
        _theme = Preferences.Current.Theme;
        _textSizePercent = Preferences.Current.TextSizePercent;
        _readingWidth = Preferences.Current.ReadingWidth;
        _lineSpacing = Preferences.Current.LineSpacing;
        _reducedMotion = Preferences.Current.ReducedMotion;
        _hideMechanicalNotes = Preferences.Current.HideMechanicalNotes;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Talewright.Player/Components/ReaderSettingsDialog.razor.js");
            await _module.InvokeVoidAsync("initialize", _dialog);
        }
    }

    public async Task OpenAsync(ElementReference? returnFocus = null)
    {
        _returnFocus = returnFocus;
        await _module!.InvokeVoidAsync("open", _dialog, returnFocus);
    }

    private async Task CloseSettings() =>
        await _module!.InvokeVoidAsync("close", _dialog, _returnFocus);

    private async Task ChangeTheme(ChangeEventArgs args)
    {
        if (!Enum.TryParse<PlayerTheme>(args.Value?.ToString(), out var theme) || !Enum.IsDefined(theme))
        {
            throw new InvalidOperationException($"Unknown theme selection '{args.Value}'.");
        }

        await Preferences.SetThemeAsync(theme);
        _theme = theme;
    }

    private async Task ChangeTextSize(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var textSizePercent)
            || !PlayerPreferences.IsSupportedTextSize(textSizePercent))
        {
            throw new InvalidOperationException($"Unknown text size selection '{args.Value}'.");
        }

        await Preferences.SetTextSizeAsync(textSizePercent);
        _textSizePercent = textSizePercent;
    }

    private async Task ChangeHideMechanicalNotes(ChangeEventArgs args)
    {
        if (args.Value is not bool hide)
        {
            throw new InvalidOperationException("Hide mechanical notes must be a checkbox value.");
        }

        await Preferences.SetHideMechanicalNotesAsync(hide);
        _hideMechanicalNotes = hide;
    }

    private async Task ChangeReadingWidth(ChangeEventArgs args)
    {
        var readingWidth = args.Value?.ToString() switch
        {
            "narrow" => PlayerReadingWidth.Narrow,
            "normal" => PlayerReadingWidth.Normal,
            "wide" => PlayerReadingWidth.Wide,
            _ => throw new InvalidOperationException($"Unknown reading width selection '{args.Value}'."),
        };

        await Preferences.SetReadingWidthAsync(readingWidth);
        _readingWidth = readingWidth;
    }

    private async Task ChangeLineSpacing(ChangeEventArgs args)
    {
        var lineSpacing = args.Value?.ToString() switch
        {
            "compact" => PlayerLineSpacing.Compact,
            "normal" => PlayerLineSpacing.Normal,
            "relaxed" => PlayerLineSpacing.Relaxed,
            _ => throw new InvalidOperationException($"Unknown line spacing selection '{args.Value}'."),
        };

        await Preferences.SetLineSpacingAsync(lineSpacing);
        _lineSpacing = lineSpacing;
    }

    private async Task ChangeReducedMotion(ChangeEventArgs args)
    {
        var reducedMotion = args.Value?.ToString() switch
        {
            "system" => PlayerReducedMotion.System,
            "reduce" => PlayerReducedMotion.Reduce,
            _ => throw new InvalidOperationException($"Unknown reduced-motion selection '{args.Value}'."),
        };

        await Preferences.SetReducedMotionAsync(reducedMotion);
        _reducedMotion = reducedMotion;
    }

    private static string ReadingWidthValue(PlayerReadingWidth readingWidth) => readingWidth switch
    {
        PlayerReadingWidth.Narrow => "narrow",
        PlayerReadingWidth.Normal => "normal",
        PlayerReadingWidth.Wide => "wide",
        _ => throw new ArgumentOutOfRangeException(nameof(readingWidth), readingWidth, "Unknown player reading width."),
    };

    private static string LineSpacingValue(PlayerLineSpacing lineSpacing) => lineSpacing switch
    {
        PlayerLineSpacing.Compact => "compact",
        PlayerLineSpacing.Normal => "normal",
        PlayerLineSpacing.Relaxed => "relaxed",
        _ => throw new ArgumentOutOfRangeException(nameof(lineSpacing), lineSpacing, "Unknown player line spacing."),
    };

    private static string ReducedMotionValue(PlayerReducedMotion reducedMotion) => reducedMotion switch
    {
        PlayerReducedMotion.System => "system",
        PlayerReducedMotion.Reduce => "reduce",
        _ => throw new ArgumentOutOfRangeException(nameof(reducedMotion), reducedMotion,
            "Unknown player reduced-motion preference."),
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", _dialog);
            await _module.DisposeAsync();
        }
    }
}
