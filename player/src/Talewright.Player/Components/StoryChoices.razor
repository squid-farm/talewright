@if (Current.IsEnded)
{
    <p class="tw-the-end">The End</p>
    <button type="button" class="tw-choice" disabled="@Busy" @onclick="OnRestart">Play again</button>
}
else
{
    @if (ContinuationError is not null)
    {
        <p class="tw-error" role="alert">@ContinuationError</p>
    }
    @if (Current.Menu.Count > 0)
    {
        <ol class="tw-choices" aria-label="Story choices">
            @foreach (var entry in Current.Menu)
            {
                <li>
                    <button type="button" class="tw-choice" disabled="@(Busy || !entry.IsAvailable)"
                            data-tw-choice="@entry.Key" @onclick="() => Choose(entry.Key)">
                        <span class="tw-choice-number">@(entry.Number).</span>
                        <InlineView Inlines="entry.Label" />
                        @if (!entry.IsAvailable)
                        {
                            <span class="tw-choice-status"> (Unavailable)</span>
                        }
                    </button>
                </li>
            }
        </ol>
    }
}

@code {
    [Parameter, EditorRequired] public StoryFrame Current { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? ContinuationError { get; set; }
    [Parameter] public EventCallback<ChoiceView> OnChoose { get; set; }
    [Parameter] public EventCallback OnRestart { get; set; }

    private Task Choose(string key) =>
        OnChoose.InvokeAsync(Current.Choices.Single(choice => choice.Key == key));
}
