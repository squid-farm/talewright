@* Plays one compiled story with bounded transcript presentation and a character sheet. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@using Talewright.Player.Saves
@using Talewright.Runtime.Saves

<div class="tw-player">
    <PlayerToolbar Title="@Story.Title" Busy="_busy" UndoEnabled="Story.UndoEnabled"
                   CanBack="_session.CanBack" CanForward="_session.CanForward" CanSave="@(SaveStore is not null)"
                   Message="@(_showSaves ? null : _saveMessage)" Error="_saveError"
                   ReadingHistory="_showHistory" OnHistory="ToggleHistory"
                   OnBack="Back" OnForward="Forward" OnQuickSave="QuickSaveAsync" OnSavedGames="ShowSavesAsync" OnRestart="Restart" OnExit="OnExit" />

    @if (SaveStore is not null)
    {
        <SavedGamesPanel Open="_showSaves" Busy="_busy" @bind-Slot="_slot" PendingOverwrite="@_pendingOverwrite" Slots="_slots"
                         Message="@_saveMessage" Error="_saveError" PendingLoad="@_pendingLoad" PendingImport="@(_pendingImport?.Slot)"
                         ImportKey="_importKey" CanExport="@(SaveExporter is not null)"
                         OnSave="SaveAsync" OnRetry="RefreshSlotsAsync" OnCancelOverwrite="() => _pendingOverwrite = null"
                         OnLoad="RequestLoadAsync" OnConfirmLoad="ConfirmLoadAsync" OnCancelLoad="CloseSaves"
                         OnImport="ImportAsync" OnConfirmImport="ConfirmImportAsync" OnCancelImport="CancelImport"
                         OnExport="ExportAsync" OnClose="CloseSaves" />
    }
    @if (_showHistory)
    {
        <TranscriptHistory @key="_session" Frames="_historyFrames" OnClose="CloseHistory" />
    }
    <div class="tw-columns" hidden="@_showHistory">
        <main class="tw-transcript" aria-label="Story transcript" aria-live="polite" tabindex="-1" @ref="_transcriptElement">
            @{ var transcript = _transcript; }
            @for (var i = Math.Max(0, transcript.Count - TranscriptPresentation.PassageWindow); i < transcript.Count; i++)
            {
                var entry = transcript[i];
                var isLatest = i == transcript.Count - 1;
                <section @key="(_session, i)" class="tw-frame @(isLatest ? "tw-latest" : "tw-past")"
                         aria-label="@(isLatest ? "Current passage" : null)" tabindex="@(isLatest ? "-1" : null)">
                    <StoryPassage Entry="entry" />
                </section>
            }

            @if (_session.Current is { } current)
            {
                <StoryChoices Current="current" Busy="_busy" AtChoiceLimit="@(_session.Cursor >= StoryHistory.MaxChoices)"
                              OnChoose="Choose" OnRestart="Restart" />
            }
        </main>

        <CharacterSheet State="_session.State" />
    </div>
</div>

@code {
    /// <summary>The compiled story to play.</summary>
    [Parameter, EditorRequired]
    public StoryDefinition Story { get; set; } = default!;

    /// <summary>Optional fixed seed (for reproducing a playthrough); otherwise the story's seed or a random one.</summary>
    [Parameter]
    public ulong? Seed { get; set; }

    [Parameter]
    public CharacterSelection? Character { get; set; }

    /// <summary>Raised when the player asks to go back to the library. The button is hidden if unset.</summary>
    [Parameter]
    public EventCallback OnExit { get; set; }

    /// <summary>False while the host hides the player (e.g. behind the library); becoming visible again re-reveals the newest frame.</summary>
    [Parameter]
    public bool Visible { get; set; } = true;

    [Parameter]
    public ISaveStore? SaveStore { get; set; }

    [Parameter]
    public ISaveFileExporter? SaveExporter { get; set; }

    private IReadOnlyList<HistoryFrame> _transcript => _session.Transcript;
    private ElementReference _transcriptElement;
    private StoryHistory _session = default!;
    private StoryDefinition? _startedStory;
    private bool _focusLatest;
    private bool _wasVisible = true;
    private IJSObjectReference? _module;
    private bool _busy;
    private bool _showSaves;
    private bool _showHistory;
    private bool _restoreReadingPosition;
    private IReadOnlyList<HistoryFrame> _historyFrames = [];
    private bool _saveError;
    private int _generation;
    private string _slot = "My save";
    private string? _pendingOverwrite;
    private string? _saveMessage;
    private IReadOnlyList<SaveEntry> _slots = [];
    private string? _pendingLoad;
    private ValidatedSaveImport? _pendingImport;
    private int _importKey;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_startedStory, Story))
        {
            Restart();
        }

        if (Visible && !_wasVisible)
        {
            _focusLatest = true;
        }

        _wasVisible = Visible;
        if (!Visible) CloseHistory();
    }

    private void Restart()
    {
        var character = ReferenceEquals(_startedStory, Story) ? _session.Character : Character;
        _startedStory = Story;
        _session = new StoryHistory(Story, Seed, character);
        _generation++;
        _busy = false;
        _showSaves = false;
        _showHistory = false;
        _historyFrames = [];
        _restoreReadingPosition = false;
        _pendingOverwrite = null;
        _pendingLoad = null;
        _pendingImport = null;
        _saveMessage = null;
        _slots = [];
        _focusLatest = true;
    }

    private void Choose(ChoiceView choice)
    {
        if (_session.Cursor >= StoryHistory.MaxChoices)
        {
            return;
        }
        _session.Choose(choice.Key);
        _focusLatest = true;
    }

    private void Back()
    {
        CloseHistory();
        _session.Back();
        _focusLatest = true;
    }

    private void Forward()
    {
        CloseHistory();
        _session.Forward();
        _focusLatest = true;
    }

    private async Task ShowSavesAsync()
    {
        CloseHistory();
        _showSaves = true;
        _pendingLoad = null;
        _pendingImport = null;
        await RefreshSlotsAsync();
    }

    private void CloseSaves()
    {
        _showSaves = false;
        _pendingLoad = null;
        _pendingImport = null;
        _pendingOverwrite = null;
    }

    private Task RefreshSlotsAsync() => SaveOperationAsync(async generation =>
    {
        var slots = await SaveStore!.ListEntriesAsync(Story.Id);
        if (generation == _generation)
        {
            _slots = slots;
        }
    });

    private Task SaveAsync(bool overwrite)
    {
        var slot = _slot.Trim();
        if (!overwrite && _slots.Any(entry => entry.Slot == slot))
        {
            _pendingOverwrite = slot;
            return Task.CompletedTask;
        }

        return SaveOperationAsync(async generation =>
        {
            SaveNames.Validate(Story.Id, slot);
            if (overwrite && _pendingOverwrite != slot)
            {
                throw new InvalidOperationException("Confirm the selected save before overwriting it.");
            }

            await PersistAsync(slot, overwrite, generation);
        });
    }

    private Task QuickSaveAsync() =>
        SaveOperationAsync(generation => PersistAsync(SaveEntry.QuickSlot, overwrite: true, generation));

    private async Task PersistAsync(string slot, bool overwrite, int generation)
    {
        var data = _session.Save(_session.CaptureSummary(DateTimeOffset.UtcNow));
        if (slot == SaveEntry.QuickSlot)
        {
            await SaveStore!.WriteQuickAsync(Story.Id, data);
        }
        else
        {
            await SaveStore!.WriteAsync(Story.Id, slot, data, overwrite);
        }
        if (generation == _generation)
        {
            _pendingOverwrite = null;
            _slots = _slots.Where(entry => entry.Slot != slot)
                .Append(StoryHistory.DescribeSave(slot, data)).OrderBy(entry => entry.Slot, StringComparer.Ordinal).ToArray();
            _saveMessage = slot == SaveEntry.QuickSlot ? "Quick Save checkpoint saved." : $"Saved '{slot}'.";
        }
    }

    private Task RequestLoadAsync(string slot) => SaveOperationAsync(async generation =>
    {
        var slots = await SaveStore!.ListEntriesAsync(Story.Id);
        if (generation != _generation)
        {
            return;
        }
        _slots = slots;
        var currentProgress = _session.TryProgressKey(out var progressKey) ? progressKey : null;
        if (currentProgress is null || !_slots.Any(entry => entry.ProgressKey == currentProgress))
        {
            _pendingLoad = slot;
            return;
        }
        await LoadAsync(slot, generation);
    });

    private Task ConfirmLoadAsync()
    {
        var slot = _pendingLoad ?? throw new InvalidOperationException("Choose a save before confirming a load.");
        return SaveOperationAsync(generation => LoadAsync(slot, generation));
    }

    private async Task LoadAsync(string slot, int generation)
    {
        var story = Story;
        var bytes = slot == SaveEntry.QuickSlot
            ? await SaveStore!.ReadQuickAsync(story.Id)
            : await SaveStore!.ReadAsync(story.Id, slot);
        var candidate = StoryHistory.Restore(story, bytes);
        if (generation == _generation)
        {
            _session = candidate;
            _showHistory = false;
            _historyFrames = [];
            _restoreReadingPosition = false;
            _pendingOverwrite = null;
            _pendingLoad = null;
            _showSaves = false;
            _saveMessage = $"Loaded '{SaveEntry.DisplayNameFor(slot)}'.";
            _focusLatest = true;
        }
    }

    private Task ExportAsync(string slot) => SaveOperationAsync(async generation =>
    {
        var story = Story;
        var data = slot == SaveEntry.QuickSlot
            ? await SaveStore!.ReadQuickAsync(story.Id)
            : await SaveStore!.ReadAsync(story.Id, slot);
        if (generation != _generation)
        {
            return;
        }

        var name = SaveEntry.DisplayNameFor(slot);
        var exported = await SaveExporter!.ExportAsync(SaveFileName.Create(story.Title, name), data);
        if (generation == _generation)
        {
            _saveMessage = exported ? $"Export requested for '{name}'." : "Export canceled.";
        }
    });

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await SaveOperationAsync(async generation =>
            {
                var story = Story;
                var slot = _slot.Trim();
                _pendingOverwrite = null;
                SaveNames.Validate(story.Id, slot);
                if (args.File.Size > StoryHistory.MaxSaveBytes)
                {
                    throw new InvalidDataException("This saved game is too large to import (maximum 2 MiB). Choose another save.");
                }

                await using var input = args.File.OpenReadStream(StoryHistory.MaxSaveBytes);
                using var buffer = new MemoryStream();
                await input.CopyToAsync(buffer);
                var data = buffer.ToArray();
                if (generation != _generation)
                {
                    return;
                }

                var pending = ValidatedSaveImport.Prepare(story, slot, data);
                var slots = await SaveStore!.ListAsync(story.Id);
                if (generation != _generation)
                {
                    return;
                }

                if (slots.Contains(slot, StringComparer.Ordinal))
                {
                    _pendingImport = pending;
                    return;
                }

                await ImportValidatedAsync(pending, overwrite: false, generation);
            });
        }
        finally
        {
            _importKey++;
        }
    }

    private Task ConfirmImportAsync()
    {
        var pending = _pendingImport ?? throw new InvalidOperationException("Choose a save before confirming an import.");
        return SaveOperationAsync(generation => ImportValidatedAsync(pending, overwrite: true, generation));
    }

    private void CancelImport() => _pendingImport = null;

    private async Task ImportValidatedAsync(ValidatedSaveImport pending, bool overwrite, int generation)
    {
        if (generation != _generation)
        {
            return;
        }

        await pending.StoreAsync(SaveStore!, overwrite);
        if (generation == _generation)
        {
            _pendingImport = null;
            _slots = _slots.Where(entry => entry.Slot != pending.Slot)
                .Append(pending.Describe())
                .OrderBy(entry => entry.Slot, StringComparer.Ordinal).ToArray();
            _saveMessage = $"Imported '{pending.Slot}'.";
        }
    }

    private async Task SaveOperationAsync(Func<int, Task> operation)
    {
        if (_busy)
        {
            return;
        }

        var generation = _generation;
        _busy = true;
        _saveMessage = null;
        _saveError = false;
        try
        {
            await operation(generation);
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException or ArgumentException or InvalidOperationException or NotSupportedException or ApplicationException or DllNotFoundException or EntryPointNotFoundException or BadImageFormatException or JSException)
        {
            if (generation == _generation)
            {
                _saveError = true;
                _saveMessage = ex switch
                {
                    FileNotFoundException or DirectoryNotFoundException =>
                        "That saved game could not be found. Refresh the list and choose another save.",
                    UnauthorizedAccessException =>
                        "The player does not have permission to access saved games. Check your save-folder permissions or browser storage settings.",
                    DllNotFoundException or EntryPointNotFoundException or BadImageFormatException =>
                        "The native save dialog could not start because a desktop library is missing or incompatible.",
                    IOException =>
                        "Saved games could not be read or written. Check that storage is available and has free space, then refresh the list and try again.",
                    JSException => $"Couldn't complete save operation: {ex.Message.Split('\n')[0]}",
                    _ => $"Couldn't complete save operation: {ex.Message}",
                };
            }
        }
        finally
        {
            if (generation == _generation)
            {
                _busy = false;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restoreReadingPosition && Visible)
        {
            _restoreReadingPosition = false;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Talewright.Player/Components/StoryPlayer.razor.js");
            await _module.InvokeVoidAsync("restoreReadingPosition", _transcriptElement);
        }
        if (_focusLatest && Visible && !_showHistory)
        {
            _focusLatest = false;

            // Scroll the newest frame to the top and focus it, so the new text is visible and screen readers move to it.
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Talewright.Player/Components/StoryPlayer.razor.js");
                await _module.InvokeVoidAsync("revealLatest", _transcriptElement, _transcript.Count == 1);
            }

            catch (JSException)
            {
                await FocusTranscriptAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
                // The element can disappear if the player restarts mid-render; nothing to reveal then.
            }
        }
    }

    private async Task ToggleHistory()
    {
        if (_showHistory)
        {
            CloseHistory();
            return;
        }
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Talewright.Player/Components/StoryPlayer.razor.js");
        await _module.InvokeVoidAsync("captureReadingPosition", _transcriptElement);
        _historyFrames = _transcript;
        _showHistory = true;
    }

    private void CloseHistory()
    {
        if (!_showHistory) return;
        _showHistory = false;
        _historyFrames = [];
        _restoreReadingPosition = true;
    }

    private async Task FocusTranscriptAsync()
    {
        try
        {
            await _transcriptElement.FocusAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
