@using Talewright.Runtime.Saves
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog class="tw-saves" aria-label="Saves" tabindex="-1" @ref="_dialog" data-busy="@(Busy ? "true" : "false")">
    <h2>Saves</h2>
    <button type="button" class="tw-link" disabled="@Busy" @onclick="OnClose">Close saves</button>
    @if (Message is not null)
    {
        <p class="@(Error ? "tw-error" : "tw-save-status")" role="@(Error ? "alert" : "status")">@Message</p>
        @if (Error)
        {
            <button type="button" class="tw-choice" disabled="@Busy" @onclick="OnRetry">Retry save list</button>
        }
    }
    @if (PendingLoad is not null)
    {
        <section aria-label="Confirm load">
            <h3>Load “@SaveEntry.DisplayNameFor(PendingLoad)”?</h3>
            <p>This will discard unsaved progress.</p>
            <button type="button" class="tw-choice" disabled="@Busy" @onclick="OnCancelLoad">Keep playing</button>
            <button type="button" class="tw-choice" disabled="@Busy" @onclick="OnConfirmLoad">Load save</button>
        </section>
    }
    else
    {
        <fieldset class="tw-save-form" disabled="@Busy">
            <legend>Create save</legend>
            <label>Save name <input aria-label="Save name" value="@Slot" @onchange="ChangeSlot" maxlength="64" /></label>
            <button type="button" @onclick="() => OnSave.InvokeAsync(false)">Save game</button>
            @if (PendingOverwrite == Slot.Trim())
            {
                <p>Replace save “@PendingOverwrite”?</p>
                <button type="button" @onclick="() => OnSave.InvokeAsync(true)">Confirm overwrite</button>
                <button type="button" @onclick="OnCancelOverwrite">Cancel overwrite</button>
            }
        </fieldset>
        <section class="tw-save-section">
            <h3 id="saved-games-heading">Saved games</h3>
            @if (Slots.Count == 0 && !Busy)
            {
                <p>No saved games.</p>
            }
            <ul class="tw-save-list" aria-label="Saved games">
                @foreach (var entry in Slots.OrderByDescending(entry => entry.Summary?.SavedAt ?? DateTimeOffset.MinValue))
                {
                    <li data-save-kind="@(entry.IsQuick ? "quick" : "named")"
                        aria-label="@($"{(entry.IsQuick ? "Checkpoint" : "Named save")}: {entry.DisplayName}")">
                        <strong>@entry.DisplayName</strong>
                        @if (entry.Summary is { } summary)
                        {
                            <span>@summary.SceneTitle</span>
                            <time datetime="@summary.SavedAt.UtcDateTime.ToString("O")"></time>
                            @if (!string.IsNullOrWhiteSpace(summary.CharacterName))
                            {
                                <span>@summary.CharacterName</span>
                            }
                        }
                        else
                        {
                            <span>Details unavailable for this saved game.</span>
                        }
                        @if (entry.Warning is not null)
                        {
                            <span class="tw-error">@entry.Warning</span>
                        }
                        <button type="button" disabled="@Busy" @onclick="() => OnLoad.InvokeAsync(entry.Slot)">Load @entry.DisplayName</button>
                    </li>
                }
            </ul>
        </section>
    }
</dialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter, EditorRequired] public string Slot { get; set; } = "";
    [Parameter] public EventCallback<string> SlotChanged { get; set; }
    [Parameter] public string? PendingOverwrite { get; set; }
    [Parameter] public string? PendingLoad { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<SaveEntry> Slots { get; set; } = [];
    [Parameter] public EventCallback<bool> OnSave { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public EventCallback OnCancelOverwrite { get; set; }
    [Parameter] public EventCallback<string> OnLoad { get; set; }
    [Parameter] public EventCallback OnConfirmLoad { get; set; }
    [Parameter] public EventCallback OnCancelLoad { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SavedGamesPanel>? _reference;
    private bool _initialized;

    private Task ChangeSlot(ChangeEventArgs args) => SlotChanged.InvokeAsync(args.Value?.ToString() ?? "");

    [JSInvokable]
    public Task DismissAsync() => OnClose.InvokeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Talewright.Player/Components/SavedGamesPanel.razor.js");
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initialize", _dialog, _reference);
            _initialized = true;
        }
        if (_initialized)
        {
            await _module!.InvokeVoidAsync("synchronize", _dialog, Open, PendingLoad);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", _dialog);
            await _module.DisposeAsync();
        }
        _reference?.Dispose();
    }
}
