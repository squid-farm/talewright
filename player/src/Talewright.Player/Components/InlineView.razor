@for (var index = 0; index < Inlines.Count; index++)
{
    var inline = Inlines[index];
    switch (inline)
    {
        case RenderedText text:
            @Styled(text)
            break;
        case RenderedLineBreak:
            <br />
            break;
        case RenderedMedia media:
            @if (HistoryReading)
            {
                <HistoryMediaView @key="(index, media, Images)" Media="media" Images="Images" />
            }
            else
            {
                <MediaView @key="(index, media, Images)" Media="media" Images="Images" />
            }
            break;
    }
}

@code {
    /// <summary>The inlines to render.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<RenderedInline> Inlines { get; set; } = [];

    [CascadingParameter]
    public StoryImages? Images { get; set; }

    [CascadingParameter(Name = "HistoryReading")]
    public bool HistoryReading { get; set; }

    private static RenderFragment Styled(RenderedText text) => builder =>
    {
        // Nest one element per style flag so "***both***" becomes <strong><em>…</em></strong>.
        var open = 0;
        if (text.Style.HasFlag(TextStyle.Strong))
        {
            builder.OpenElement(0, "strong");
            open++;
        }

        if (text.Style.HasFlag(TextStyle.Emphasis))
        {
            builder.OpenElement(1, "em");
            open++;
        }

        if (text.Style.HasFlag(TextStyle.Code))
        {
            builder.OpenElement(2, "code");
            open++;
        }

        builder.AddContent(3, text.Text);
        for (var i = 0; i < open; i++)
        {
            builder.CloseElement();
        }
    };
}
