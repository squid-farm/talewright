@implements IAsyncDisposable
@inject IServiceProvider Services
@inject IJSRuntime JS
@using System.Text
@using Microsoft.Extensions.DependencyInjection
@using Talewright.Player.Diagnostics

<dialog class="tw-diagnostic-report" aria-label="Diagnostics" @ref="_dialog">
    <h2>Diagnostic report</h2>
    <p>Review this report before sharing it. It includes story and scene IDs, but not story text, saved games, paths or exception messages. It is not sent automatically.</p>
    <pre tabindex="0" aria-label="Diagnostic report" @ref="_report">@Diagnostics.CreateReport()</pre>
    @if (Services.GetService<IDiagnosticReportExporter>() is not null)
    {
        <button type="button" class="tw-choice tw-diagnostic-download" @onclick="DownloadAsync">Download diagnostic report</button>
    }
    else
    {
        <p>Downloading diagnostic reports is unavailable in this host.</p>
    }
    @if (_status is not null)
    {
        <p role="@(_failed ? "alert" : "status")">@_status</p>
    }
    <button type="button" class="tw-choice tw-diagnostic-close" @onclick="CloseAsync">Close diagnostics</button>
</dialog>

@code {
    [Parameter, EditorRequired]
    public PlayerDiagnostics Diagnostics { get; set; } = default!;

    private ElementReference _dialog;
    private ElementReference _report;
    private IJSObjectReference? _module;
    private string? _status;
    private bool _failed;

    protected override void OnInitialized() => Diagnostics.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Talewright.Player/Components/DiagnosticReport.razor.js");
        await _module.InvokeVoidAsync("initialize", _dialog, _report);
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public Task OpenAsync(ElementReference? returnFocus = null) =>
        _module!.InvokeVoidAsync("open", _dialog, returnFocus).AsTask();

    private Task CloseAsync() => _module!.InvokeVoidAsync("close", _dialog).AsTask();

    private async Task DownloadAsync()
    {
        try
        {
            var bytes = Encoding.UTF8.GetBytes(Diagnostics.CreateReport());
            var exporter = Services.GetRequiredService<IDiagnosticReportExporter>();
            _status = await exporter.ExportAsync("talewright-diagnostics.txt", bytes)
                ? "Diagnostic report download requested."
                : "Diagnostic report download canceled.";
            _failed = false;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or
            NotSupportedException or DllNotFoundException or EntryPointNotFoundException or BadImageFormatException or JSException)
        {
            Diagnostics.Record(PlayerDiagnosticOperation.ReportExport, ex);
            _status = "The diagnostic report could not be downloaded. Check your storage or browser settings and try again.";
            _failed = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Diagnostics.Changed -= OnChanged;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", _dialog);
            await _module.DisposeAsync();
        }
    }
}
