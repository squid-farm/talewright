@using Talewright.Narrative.Templates

<span class="tw-history-media">
    <button type="button" class="tw-link" aria-expanded="@(_revealed ? "true" : "false")" @onclick="Toggle">
        @ToggleText
    </button>
    @if (_revealed)
    {
        <span class="tw-history-image">
            <MediaView Media="Media" Images="Images" />
        </span>
    }
</span>

@code {
    [Parameter, EditorRequired] public RenderedMedia Media { get; set; } = default!;
    [Parameter] public StoryImages? Images { get; set; }
    private bool _revealed;
    private string ToggleText => Media.Accessibility == MediaAccessibility.Decorative
        ? _revealed ? "Hide decorative image" : "Reveal decorative image"
        : (_revealed ? "Hide image: " : "Reveal image: ") + Media.AltText;

    private void Toggle() => _revealed = !_revealed;
}
