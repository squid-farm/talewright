@implements IAsyncDisposable
@inject IJSRuntime JS
@using Talewright.Player.Diagnostics
@using Talewright.Narrative.Templates

<span class="tw-media @PresentationClass @StyleClass" aria-hidden="@(Media.Accessibility == MediaAccessibility.Decorative ? "true" : null)">
    <img @ref="_image" alt="@(Media.Accessibility == MediaAccessibility.Decorative ? "" : Media.AltText)"
         hidden="@(_error is not null)" />
    @if (CanExpand)
    {
        <button @ref="_trigger" type="button" class="tw-media-trigger"
                aria-label="Expand image: @Media.AltText" aria-haspopup="dialog"
                aria-expanded="@(_lightboxOpen ? "true" : "false")" @onclick="OpenLightbox"></button>
    }
    @if (_error is not null)
    {
        <span class="tw-media-error">
            <span role="img" aria-label="@Media.AltText">@Media.AltText</span>
            <span role="status">— @_error</span>
        </span>
    }
</span>
@if (CanExpand && _lightboxOpen)
{
    <dialog @ref="_lightbox" class="tw-image-lightbox" aria-label="@Media.AltText">
        <button type="button" class="tw-image-lightbox-close" @onclick="CloseLightbox">Close image</button>
        <img @ref="_lightboxImage" alt="@(Media.Accessibility == MediaAccessibility.Decorative ? "" : Media.AltText)" />
    </dialog>
}

@code {
    [Parameter, EditorRequired] public RenderedMedia Media { get; set; } = default!;
    [Parameter] public StoryImages? Images { get; set; }
    [Parameter] public bool ChoiceLabel { get; set; }
    [CascadingParameter] public PlayerDiagnostics? Report { get; set; }

    private ElementReference _image;
    private ElementReference _trigger;
    private ElementReference _lightbox;
    private ElementReference _lightboxImage;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MediaView>? _reference;
    private CancellationTokenSource? _loading;
    private StoryImages.Lease? _lease;
    private StoryImages? _boundImages;
    private string? _boundMediaId;
    private Task _activeLoad = Task.CompletedTask;
    private int _sourceGeneration;
    private int _handle;
    private bool _disposed;
    private bool _observationStarted;
    private bool _started;
    private bool _reloadAfterRender;
    private bool _imageMeasured;
    private bool _smallImage;
    private bool _lightboxOpen;
    private bool _openLightboxAfterRender;
    private string? _error;
    private Task _initializing = Task.CompletedTask;
    private bool IsSmallImage => ChoiceLabel || _smallImage || Images?.IsSmallImage(Media.MediaId) == true;
    private bool CanExpand => _imageMeasured && !IsSmallImage && !ChoiceLabel &&
        Media.Accessibility != MediaAccessibility.Decorative;
    private string PresentationClass => ChoiceLabel ? "tw-media-choice-label" :
        IsSmallImage ? "tw-media-small" : CanExpand ? "tw-media-illustration" : "";
    private string StyleClass => string.Join(" ", new[]
    {
        Media.Style.HasFlag(TextStyle.Strong) ? "tw-media-strong" : "",
        Media.Style.HasFlag(TextStyle.Emphasis) ? "tw-media-emphasis" : "",
        Media.Style.HasFlag(TextStyle.Code) ? "tw-media-code" : "",
    }.Where(value => value.Length > 0));

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_boundImages, Images) && _boundMediaId == Media.MediaId) return;

        var reload = _started;
        _boundImages = Images;
        _boundMediaId = Media.MediaId;
        ++_sourceGeneration;
        _imageMeasured = false;
        _smallImage = false;
        _lightboxOpen = false;
        _openLightboxAfterRender = false;
        _started = false;
        _reloadAfterRender = reload;
        var loading = _loading;
        _loading = null;
        loading?.Cancel();
        await _activeLoad;
        var previousLease = _lease;
        _lease = null;
        if (previousLease is not null) await previousLease.DisposeAsync();

        if (Images is null)
        {
            var wasUnavailable = _error == "Images are unavailable for this story source.";
            _error = "Images are unavailable for this story source.";
            if (!wasUnavailable) Report?.Record(PlayerDiagnosticOperation.ImageLoad, PlayerDiagnosticCause.Unavailable);
            return;
        }

        _error = null;
        _lease = Images.TryAcquireExisting(Media.MediaId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_observationStarted && Images is not null)
        {
            _observationStarted = true;
            _initializing = ObserveAsync();
        }
        if (_reloadAfterRender)
        {
            _reloadAfterRender = false;
            await _initializing;
            if (!_disposed && Images is not null) await LoadAsync();
        }

        if (_openLightboxAfterRender)
        {
            _openLightboxAfterRender = false;
            if (!_disposed && CanExpand && _module is not null)
                await _module.InvokeVoidAsync("openLightbox", _handle, _trigger, _lightbox, _lightboxImage);
        }
    }

    private async Task ObserveAsync()
    {
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Talewright.Player/Components/MediaView.razor.js");
            if (_disposed) return;
            _reference = DotNetObjectReference.Create(this);
            _handle = await _module.InvokeAsync<int>("observe", _image, _reference);
        }
        catch (JSException ex)
        {
            if (!_disposed)
            {
                _error = "Image loading is unavailable in this host.";
                Console.Error.WriteLine($"Image loader failed: {ex.Message}");
                Report?.Record(PlayerDiagnosticOperation.ImageLoad, ex);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    [JSInvokable]
    public Task LoadAsync()
    {
        var module = _module;
        if (_disposed || _started || Images is null || Images.Lifetime.IsCancellationRequested || module is null)
            return Task.CompletedTask;
        _started = true;
        var images = Images;
        var generation = _sourceGeneration;
        var loading = CancellationTokenSource.CreateLinkedTokenSource(images.Lifetime);
        _loading = loading;
        return _activeLoad = LoadAsync(images, generation, loading, module);
    }

    private async Task LoadAsync(StoryImages images, int generation, CancellationTokenSource loading,
        IJSObjectReference module)
    {
        var token = loading.Token;
        var lease = _lease;
        try
        {
            string url;
            if (lease is { } claimed)
            {
                try
                {
                    url = await claimed.Url.WaitAsync(token);
                }
                catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException or JSException or OperationCanceledException
                    && !_disposed && !token.IsCancellationRequested)
                {
                    Console.Error.WriteLine($"Image '{Media.MediaId}' warmed transfer failed: {ex.Message}");
                    Report?.Record(PlayerDiagnosticOperation.ImageLoad, ex, warning: true);
                    await claimed.DisposeAsync();
                    if (!IsCurrent(images, generation)) return;
                    lease = images.Acquire(Media.MediaId, JS);
                    _lease = lease;
                    url = await lease.Url.WaitAsync(token);
                }
            }
            else
            {
                lease = images.Acquire(Media.MediaId, JS);
                _lease = lease;
                url = await lease.Url.WaitAsync(token);
            }
            if (!IsCurrent(images, generation) || token.IsCancellationRequested) return;
            var loaded = await module.InvokeAsync<bool>("display", token, _handle, url);
            if (!loaded && IsCurrent(images, generation))
            {
                _error = "This image could not be displayed.";
                Report?.Record(PlayerDiagnosticOperation.ImageLoad, PlayerDiagnosticCause.InvalidData);
            }
            if (loaded && IsCurrent(images, generation))
            {
                var dimensions = await module.InvokeAsync<int[]>("dimensions", _handle);
                if (!IsCurrent(images, generation) || token.IsCancellationRequested) return;
                if (dimensions.Length != 2 || dimensions[0] <= 0 || dimensions[1] <= 0)
                    throw new InvalidDataException("The image's natural dimensions are unavailable.");
                images.RecordImageDimensions(Media.MediaId, dimensions[0], dimensions[1]);
                _smallImage = dimensions[0] <= StoryImages.SmallImageMaxWidth &&
                    dimensions[1] <= StoryImages.SmallImageMaxHeight;
                _imageMeasured = true;
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException
            && (_disposed || token.IsCancellationRequested || images.Lifetime.IsCancellationRequested))
        {
            return;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException or JSException)
        {
            if (IsCurrent(images, generation))
            {
                _error = "This image could not be loaded.";
                Console.Error.WriteLine($"Image '{Media.MediaId}' failed: {ex.Message}");
                Report?.Record(PlayerDiagnosticOperation.ImageLoad, ex);
            }
        }
        finally
        {
            if (ReferenceEquals(_loading, loading)) _loading = null;
            loading.Dispose();
        }
        if (IsCurrent(images, generation)) await InvokeAsync(StateHasChanged);
    }

    private void OpenLightbox()
    {
        if (!CanExpand || _lightboxOpen) return;
        _lightboxOpen = true;
        _openLightboxAfterRender = true;
    }

    private async Task CloseLightbox()
    {
        if (_module is not null) await _module.InvokeVoidAsync("closeLightbox", _handle);
    }

    [JSInvokable]
    public Task LightboxClosed()
    {
        if (_disposed) return Task.CompletedTask;
        _lightboxOpen = false;
        return InvokeAsync(StateHasChanged);
    }

    private bool IsCurrent(StoryImages images, int generation) =>
        !_disposed && generation == _sourceGeneration && ReferenceEquals(images, Images);

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _loading?.Cancel();
        await _initializing;
        await _activeLoad;
        if (_module is not null)
        {
            try
            {
                if (_handle != 0) await _module.InvokeVoidAsync("release", _handle);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The host already destroyed this document and its object URLs.
            }
        }
        _reference?.Dispose();
        if (_lease is not null) await _lease.DisposeAsync();
    }
}
