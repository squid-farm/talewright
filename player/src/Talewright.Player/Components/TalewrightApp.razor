@* The whole player: pick a story from the library (or upload a .zip), compile it, then play it.
   Hosts render just this component; everything else is shared between desktop and web. *@
@inject IStoryLibrary Library
@inject IServiceProvider Services
@inject Talewright.Player.Preferences.PlayerPreferencesStore Preferences
@using Microsoft.Extensions.DependencyInjection
@using Talewright.Player.Saves
@using Talewright.Runtime.Saves
@implements IAsyncDisposable

@if (!_preferencesReady)
{
    <div class="tw-app" aria-busy="true"></div>
}
else
{
<div class="tw-app">
    @if (_story is not null)
    {
        @* Kept mounted while the library is open so the playthrough survives a trip to the library. *@
        <CascadingValue Value="_loaded!.Images">
        <div hidden="@_showLibrary" @key="_loaded">
            @if (!_resumeCheckComplete)
            {
                <section class="tw-resume-prompt" aria-label="Checking saved progress" aria-busy="true">
                    <p>Checking for an autosave…</p>
                </section>
            }
            else if (_resumeHistory is not null && !_resumeAccepted)
            {
                <section class="tw-resume-prompt" aria-labelledby="tw-resume-heading">
                    <h2 id="tw-resume-heading">Resume this story?</h2>
                    <p>An autosave is available. You can resume it or start a new playthrough.</p>
                    @if (_resumeSummary is { } summary)
                    {
                        <p>@summary.SceneTitle
                            @if (!string.IsNullOrWhiteSpace(summary.CharacterName))
                            {
                                <span> · @summary.CharacterName</span>
                            }
                            <span aria-hidden="true"> · </span>
                            <time datetime="@summary.SavedAt.UtcDateTime.ToString("O")">@summary.SavedAt.ToLocalTime().ToString("g")</time>
                        </p>
                    }
                    <button type="button" class="tw-choice" @onclick="ResumeAutosave">Resume saved game</button>
                    <button type="button" class="tw-choice" @onclick="StartNewGame">Start a new game</button>
                </section>
            }
            else if (_resumeCheckError is not null)
            {
                <section class="tw-resume-prompt" aria-label="Autosave unavailable">
                    <p class="tw-error" role="alert">@_resumeCheckError</p>
                    <button type="button" class="tw-choice" @onclick="RetryAutosaveCheckAsync">Retry autosave check</button>
                    <button type="button" class="tw-choice" @onclick="StartNewGame">Start a new game</button>
                </section>
            }
            else if (_story.Creation is not null && _character is null)
            {
                <CharacterCreator @key="_story" Story="_story" OnCreated="CharacterCreated" />
                @if (LibraryEnabled)
                {
                    <button type="button" class="tw-link tw-creation-library" @onclick="ShowLibrary">Library</button>
                }
            }
            else
            {
                <StoryPlayer Story="_story" Character="_character" Visible="!_showLibrary" OnExit="@(LibraryEnabled ? EventCallback.Factory.Create(this, ShowLibrary) : default)" SaveStore="SaveStore" SaveExporter="Services.GetService<ISaveFileExporter>()" ResumeHistory="@(_resumeAccepted ? _resumeHistory : null)" AutosaveResumeChecked="true" />
            }
        </div>
        </CascadingValue>
    }

    @if (!LibraryEnabled && _story is null)
    {
        <section aria-label="Story startup">
            <h1>@(_failedTitle ?? "Talewright")</h1>
            @if (_error is not null)
            {
                <p class="tw-error" role="alert">@_error</p>
            }
            @if (_diagnostics.Count > 0)
            {
                <DiagnosticList Diagnostics="_diagnostics" />
            }
            @if (_entries?.Any(entry => entry.Id == AutoStartStoryId) == true)
            {
                <button type="button" class="tw-choice" @onclick="RetryStoryAsync">Retry opening story</button>
            }
        </section>
    }
    else if (LibraryEnabled && (_story is null || _showLibrary))
    {
        <section class="tw-library">
            <h1>Talewright</h1>

            @if (_story is not null)
            {
                <button type="button" class="tw-choice tw-resume" @onclick="ResumeStory">
                    <span class="tw-story-title">Back to @_story.Title</span>
                    <span class="tw-story-origin">Continue where you left off</span>
                </button>
            }

            @if (_entries is null)
            {
                <p>Loading stories…</p>
            }
            else
            {
                <h2>Stories</h2>
                @if (_entries.Count == 0)
                {
                    <p class="tw-empty">No stories found.</p>
                }
                <ul class="tw-story-list">
                    @foreach (var entry in _entries)
                    {
                        <li>
                            <button type="button" class="tw-choice" @onclick="() => OpenAsync(entry)">
                                <span class="tw-story-title">@entry.Title</span>
                                <span class="tw-story-origin">@entry.Origin</span>
                            </button>
                        </li>
                    }
                </ul>

                <h2>Open a story file</h2>
                <p>Choose a <code>.zip</code> containing <code>story.talewright.yaml</code> and its <code>.tale</code> files.</p>
                <InputFile OnChange="UploadAsync" accept=".zip" aria-label="Story archive" />
            }

            @if (_error is not null)
            {
                <p class="tw-error" role="alert">@_error</p>
            }

            @if (_diagnostics.Count > 0)
            {
                <h2>@(_failedTitle ?? "Story") has problems</h2>
                <DiagnosticList Diagnostics="_diagnostics" />
            }
        </section>
    }
</div>
}

@code {
    /// <summary>Library id of a story to open immediately (the desktop host passes this for a command-line path).</summary>
    [Parameter]
    public string? AutoStartStoryId { get; set; }

    /// <summary>Whether players can browse, upload, or return to the library. Independent of auto-start.</summary>
    [Parameter]
    public bool LibraryEnabled { get; set; } = true;

    /// <summary>Largest upload accepted, in bytes.</summary>
    [Parameter]
    public long MaxUploadBytes { get; set; } = 20 * 1024 * 1024;

    [Parameter]
    public EventCallback<string?> OnTitleChanged { get; set; }

    /// <summary>Explicit extensions shared with the author's build-time compiler.</summary>
    [Parameter]
    public CompilerOptions Options { get; set; } = CompilerOptions.Default;

    private IReadOnlyList<StoryEntry>? _entries;
    private StoryDefinition? _story;
    private LoadedStory? _loaded;
    private long _openGeneration;
    private bool _disposed;
    private CharacterSelection? _character;
    private bool _showLibrary;
    private bool _preferencesReady;
    private bool _resumeCheckComplete = true;
    private bool _resumeAccepted;
    private StoryHistory? _resumeHistory;
    private SaveSummary? _resumeSummary;
    private string? _resumeCheckError;
    private IReadOnlyList<Diagnostic> _diagnostics = [];
    private string? _error;
    private string? _failedTitle;
    private ISaveStore? SaveStore => Services.GetService<ISaveStore>();

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        _preferencesReady = true;

        if (!LibraryEnabled && AutoStartStoryId is null)
        {
            throw new InvalidOperationException("A story must be selected when the library is disabled.");
        }
        _entries = await Library.ListAsync();
        if (AutoStartStoryId is not null && _entries.FirstOrDefault(e => e.Id == AutoStartStoryId) is { } entry)
        {
            await OpenAsync(entry);
        }
        else if (!LibraryEnabled)
        {
            _error = "The selected story could not be found.";
        }
    }

    private Task RetryStoryAsync() => OpenAsync(_entries!.First(entry => entry.Id == AutoStartStoryId));

    private async Task OpenAsync(StoryEntry entry)
    {
        var generation = ++_openGeneration;
        Reset();
        LoadedStory? candidate = null;
        try
        {
            candidate = await Library.OpenAsync(entry.Id);
            if (_disposed || generation != _openGeneration) return;
            await CompileAsync(candidate, entry.Title, generation);
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException or KeyNotFoundException)
        {
            if (!_disposed && generation == _openGeneration)
                _error = $"Couldn't open {entry.Title}: {ex.Message}";
        }
        finally
        {
            if (!ReferenceEquals(candidate, _loaded)) candidate?.Dispose();
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        var generation = ++_openGeneration;
        Reset();
        LoadedStory? candidate = null;
        try
        {
            // FromZip needs a seekable stream; browser streams aren't, so buffer first.
            var buffer = new MemoryStream();
            try
            {
                await using (var upload = e.File.OpenReadStream(MaxUploadBytes))
                {
                    await upload.CopyToAsync(buffer);
                }

                buffer.Position = 0;
                if (_disposed || generation != _openGeneration) return;
                candidate = ArchiveStoryImages.Open(buffer);
            }
            finally
            {
                if (candidate is null) await buffer.DisposeAsync();
            }
            await CompileAsync(candidate, e.File.Name, generation);
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException)
        {
            if (!_disposed && generation == _openGeneration)
                _error = $"Couldn't read {e.File.Name}: {ex.Message}";
        }
        finally
        {
            if (!ReferenceEquals(candidate, _loaded)) candidate?.Dispose();
        }
    }

    private async Task CompileAsync(LoadedStory loaded, string title, long generation)
    {
        var result = StoryCompiler.Compile(loaded.Source, Options);
        _diagnostics = result.Diagnostics;
        if (result.Success)
        {
            var previous = _loaded;
            _loaded = loaded;
            _story = result.Story;
            _character = null;
            _resumeAccepted = false;
            _resumeHistory = null;
            _resumeSummary = null;
            _resumeCheckError = null;
            _resumeCheckComplete = false;
            _showLibrary = false;
            _diagnostics = [];
            if (previous is not null) await previous.DisposeAsync();
            await OnTitleChanged.InvokeAsync(_story!.Title);
            await CheckAutosaveAsync(_story, generation);
        }
        else
        {
            _failedTitle = title;
        }
    }

    private void Reset()
    {
        _error = null;
        _failedTitle = null;
        _diagnostics = [];
    }

    private async Task CheckAutosaveAsync(StoryDefinition story, long generation)
    {
        var store = SaveStore;
        if (store is null)
        {
            _resumeCheckComplete = true;
            return;
        }

        try
        {
            var bytes = await store.ReadAutosaveAsync(story.Id);
            if (_disposed || generation != _openGeneration) return;
            _resumeHistory = StoryHistory.Restore(story, bytes);
            _resumeSummary = StoryHistory.DescribeSave(SaveEntry.AutosaveSlot, bytes).Summary;
        }
        catch (FileNotFoundException)
        {
            if (!_disposed && generation == _openGeneration)
            {
                _resumeHistory = null;
                _resumeSummary = null;
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException or ArgumentException or InvalidOperationException or NotSupportedException or ApplicationException or JSException)
        {
            if (!_disposed && generation == _openGeneration)
            {
                _resumeHistory = null;
                _resumeSummary = null;
                _resumeCheckError = $"Couldn't check this story's autosave: {ex.Message}";
            }
        }
        finally
        {
            if (!_disposed && generation == _openGeneration)
            {
                _resumeCheckComplete = true;
            }
        }
    }

    private Task RetryAutosaveCheckAsync()
    {
        if (_story is null) return Task.CompletedTask;
        _resumeCheckComplete = false;
        _resumeCheckError = null;
        return CheckAutosaveAsync(_story, _openGeneration);
    }

    private void ResumeAutosave()
    {
        if (_resumeHistory is null) throw new InvalidOperationException("No autosave is available to resume.");
        _character = _resumeHistory.Character;
        _resumeAccepted = true;
    }

    private void StartNewGame()
    {
        _resumeHistory = null;
        _resumeSummary = null;
        _resumeCheckError = null;
        _resumeAccepted = false;
        _resumeCheckComplete = true;
        _character = null;
    }

    private void CharacterCreated(CharacterSelection character) => _character = character;

    private async Task ShowLibrary()
    {
        Reset();
        _showLibrary = true;
        await OnTitleChanged.InvokeAsync(null);
    }

    private async Task ResumeStory()
    {
        Reset();
        _showLibrary = false;
        await OnTitleChanged.InvokeAsync(_story!.Title);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ++_openGeneration;
        if (_loaded is not null) await _loaded.DisposeAsync();
    }
}
