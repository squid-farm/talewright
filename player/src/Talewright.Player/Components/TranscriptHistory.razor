@implements IAsyncDisposable
@inject IJSRuntime JS

<main class="tw-transcript tw-history" aria-label="Recorded history" @ref="_element">
    <h2 tabindex="-1" class="tw-history-heading">History</h2>
    <p>Recorded passages and choices. Reading history does not change your playthrough.</p>
    <nav aria-label="History pages">
        <button type="button" class="tw-link" @onclick="OnClose">Return to play</button>
        <button type="button" class="tw-link" disabled="@(_start == 0)" @onclick="Earlier">Earlier passages</button>
        <button type="button" class="tw-link" disabled="@(_start + TranscriptPresentation.PassageWindow >= Frames.Count)"
                @onclick="Later">Later passages</button>
        <p>Passages @(_start + 1)-@End of @Frames.Count</p>
    </nav>
    <CascadingValue Name="HistoryReading" Value="true" IsFixed="true">
        @for (var index = _start; index < End; index++)
        {
            <section @key="(Frames, index)" class="tw-history-frame">
                <StoryPassage Entry="Frames[index]" />
            </section>
        }
    </CascadingValue>
</main>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HistoryFrame> Frames { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    private int _start;
    private bool _focusPage = true;
    private ElementReference _element;
    private Task<IJSObjectReference>? _module;
    private bool _disposed;
    private int End => Math.Min(_start + TranscriptPresentation.PassageWindow, Frames.Count);

    protected override void OnInitialized() =>
        _start = (Frames.Count - 1) / TranscriptPresentation.PassageWindow * TranscriptPresentation.PassageWindow;

    private void Earlier()
    {
        _start = Math.Max(0, _start - TranscriptPresentation.PassageWindow);
        _focusPage = true;
    }

    private void Later()
    {
        _start = Math.Min((Frames.Count - 1) / TranscriptPresentation.PassageWindow * TranscriptPresentation.PassageWindow,
            _start + TranscriptPresentation.PassageWindow);
        _focusPage = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPage) return;
        _focusPage = false;
        var module = await (_module ??= JS.InvokeAsync<IJSObjectReference>("import",
            "./_content/Talewright.Player/Components/StoryPlayer.razor.js").AsTask());
        if (!_disposed) await module.InvokeVoidAsync("focusHistoryPage", _element);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await (await _module).DisposeAsync(); }
            catch (JSDisconnectedException)
            {
                // The host has already destroyed the document.
            }
        }
    }
}
