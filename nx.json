{
  "installation": {
    "version": "24.0.0",
    "plugins": {
      "@nx/dotnet": "24.0.0"
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "targetDefaults": {
    "*": {
      "cache": false
    },
    "build": {
      "cache": false,
      "parallelism": false,
      "options": {
        "args": ["--no-dependencies"]
      }
    },
    "build:release": {
      "cache": false,
      "parallelism": false,
      "options": {
        "args": ["--no-dependencies", "--configuration", "Release"]
      }
    },
    "test": {
      "cache": false,
      "dependsOn": ["build:release"],
      "options": {
        "args": [
          "--no-build", "--no-restore", "--configuration", "Release",
          "--logger", "trx", "--results-directory", "artifacts/unit"
        ]
      }
    },
    "lint": {
      "cache": false
    }
  },
  "plugins": [
    "@nx/dotnet"
  ],
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/.github/**/*",
      "{workspaceRoot}/Directory.Build.*",
      "{workspaceRoot}/Directory.Packages.props",
      "{workspaceRoot}/NuGet.Config",
      "{workspaceRoot}/Talewright.slnx",
      "{workspaceRoot}/global.json",
      "{workspaceRoot}/nx.json"
    ],
    "default": [
      "sharedGlobals",
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.Tests/**/*",
      "!{projectRoot}/**/bin/**/*",
      "!{projectRoot}/**/obj/**/*"
    ]
  }
}
