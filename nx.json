{
  "installation": {
    "version": "24.0.0",
    "plugins": {
      "@nx/dotnet": "24.0.0"
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "lint": {
      "cache": true
    }
  },
  "plugins": [
    "@nx/dotnet"
  ],
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/.github/**/*",
      "{workspaceRoot}/Directory.Build.*",
      "{workspaceRoot}/Directory.Packages.props",
      "{workspaceRoot}/NuGet.Config",
      "{workspaceRoot}/Talewright.slnx",
      "{workspaceRoot}/global.json",
      "{workspaceRoot}/nx.json"
    ],
    "default": [
      "sharedGlobals",
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.Tests/**/*",
      "!{projectRoot}/**/bin/**/*",
      "!{projectRoot}/**/obj/**/*"
    ]
  }
}
