{
  "installation": {
    "version": "24.0.0",
    "plugins": {
      "@nx/dotnet": "24.0.0"
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "targetDefaults": {
    "*": {
      "cache": false
    },
    "build": {
      "cache": false,
      "parallelism": false,
      "options": {
        "args": ["--no-dependencies"]
      }
    },
    "build:release": {
      "cache": false,
      "parallelism": false,
      "options": {
        "args": ["--no-dependencies", "--configuration", "Release"]
      }
    },
    "test": {
      "cache": false,
      "dependsOn": ["build:release"],
      "inputs": [
        "default",
        "^production",
        {"workingDirectory": "absolute"},
        {"dependentTasksOutputFiles": "**/*"},
        {"env": "NUGET_PACKAGES"},
        "{workspaceRoot}/Directory.Build.props",
        "{workspaceRoot}/global.json",
        "testWorkflow"
      ],
      "options": {
        "args": [
          "--no-build", "--no-restore", "--configuration", "Release",
          "--logger", "trx", "--results-directory", "artifacts/unit"
        ]
      }
    },
    "lint": {
      "cache": false
    },
    "compiler-contract": {
      "cache": false,
      "inputs": ["default", "^default", "editorWorkflow"]
    },
    "check": {
      "cache": false,
      "inputs": ["default", "^default", "testWorkflow"]
    },
    "budget": {
      "cache": false,
      "inputs": ["default", "^default", "testWorkflow"]
    }
  },
  "plugins": [
    "@nx/dotnet"
  ],
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/Directory.Build.*",
      "{workspaceRoot}/Directory.Packages.props",
      "{workspaceRoot}/NuGet.Config",
      "{workspaceRoot}/Talewright.slnx",
      "{workspaceRoot}/global.json",
      "{workspaceRoot}/nx.json"
    ],
    "testWorkflow": [
      "{workspaceRoot}/.github/workflows/tests.yml"
    ],
    "editorWorkflow": [
      "testWorkflow",
      "{workspaceRoot}/.github/workflows/editor-tooling.yml",
      "{workspaceRoot}/.github/scripts/package_version.py",
      "{workspaceRoot}/.github/scripts/verify_release_vsix.py"
    ],
    "packageInfrastructure": [
      "{workspaceRoot}/.github/workflows/build.yml",
      "{workspaceRoot}/.github/workflows/publish-nuget.yml",
      "{workspaceRoot}/.github/scripts/package_version.py",
      "{workspaceRoot}/.github/scripts/verify_packages.py",
      "{workspaceRoot}/.github/scripts/verify_release_vsix.py",
      "{workspaceRoot}/.github/scripts/github_release.py",
      "{workspaceRoot}/.github/scripts/package_cli.sh"
    ],
    "browserInfrastructure": [
      "testWorkflow",
      "{workspaceRoot}/.github/workflows/publish-samples.yml",
      "{workspaceRoot}/.github/scripts/publish_samples.py",
      "{workspaceRoot}/.github/scripts/hosted_site.py",
      "{workspaceRoot}/.github/scripts/hosted_store.py"
    ],
    "default": [
      "sharedGlobals",
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.Tests/**/*",
      "!{projectRoot}/**/bin/**/*",
      "!{projectRoot}/**/obj/**/*"
    ]
  }
}
