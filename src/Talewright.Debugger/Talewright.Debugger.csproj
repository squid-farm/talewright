<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <ProjectReference Include="../Talewright.Player/Talewright.Player.csproj" />
    <ProjectReference Include="../Talewright.Runtime/Talewright.Runtime.csproj" />
    <Content Update="wwwroot/**" TargetPath="debug-assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Talewright.Player/wwwroot/talewright.css" Link="debug-assets/_content/Talewright.Player/talewright.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
