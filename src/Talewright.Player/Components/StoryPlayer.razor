@* Plays one compiled story: transcript of everything so far, current choices, and a character sheet. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="tw-player">
    <header class="tw-bar">
        <h1>@Story.Title</h1>
        <div class="tw-bar-actions">
            <button type="button" class="tw-link" @onclick="Restart">Restart</button>
            @if (OnExit.HasDelegate)
            {
                <button type="button" class="tw-link" @onclick="() => OnExit.InvokeAsync()">Library</button>
            }
        </div>
    </header>

    <div class="tw-columns">
        <main class="tw-transcript" aria-label="Story transcript" aria-live="polite">
            @for (var i = 0; i < _transcript.Count; i++)
            {
                var entry = _transcript[i];
                var isLatest = i == _transcript.Count - 1;
                if (isLatest)
                {
                    <section class="tw-frame tw-latest" aria-label="Current passage" tabindex="-1" @ref="_latestFrame">@FrameContent(entry)</section>
                }
                else
                {
                    <section class="tw-frame tw-past">@FrameContent(entry)</section>
                }
            }

            @if (_session.Current is { } current)
            {
                if (current.IsEnded)
                {
                    <p class="tw-the-end">The End</p>
                    <button type="button" class="tw-choice" @onclick="Restart">Play again</button>
                }
                else
                {
                    <ol class="tw-choices" aria-label="Story choices">
                        @for (var i = 0; i < current.Choices.Count; i++)
                        {
                            var choice = current.Choices[i];
                            <li>
                                <button type="button" class="tw-choice" @onclick="() => Choose(choice)">
                                    <span class="tw-choice-number">@(i + 1).</span>
                                    <InlineView Inlines="choice.Label" />
                                </button>
                            </li>
                        }
                    </ol>
                }
            }
        </main>

        <CharacterSheet State="_session.State" />
    </div>
</div>

@code {
    /// <summary>The compiled story to play.</summary>
    [Parameter, EditorRequired]
    public StoryDefinition Story { get; set; } = default!;

    /// <summary>Optional fixed seed (for reproducing a playthrough); otherwise the story's seed or a random one.</summary>
    [Parameter]
    public ulong? Seed { get; set; }

    /// <summary>Raised when the player asks to go back to the library. The button is hidden if unset.</summary>
    [Parameter]
    public EventCallback OnExit { get; set; }

    /// <summary>False while the host hides the player (e.g. behind the library); becoming visible again re-reveals the newest frame.</summary>
    [Parameter]
    public bool Visible { get; set; } = true;

    private sealed record TranscriptEntry(StoryFrame Frame)
    {
        public IReadOnlyList<RenderedInline>? Chosen { get; set; }
    }

    private readonly List<TranscriptEntry> _transcript = [];
    private ElementReference _latestFrame;
    private StorySession _session = default!;
    private StoryDefinition? _startedStory;
    private bool _focusLatest;
    private bool _wasVisible = true;
    private IJSObjectReference? _module;

    private RenderFragment FrameContent(TranscriptEntry entry) => @<text>
        @if (!string.IsNullOrEmpty(entry.Frame.Title))
        {
            <h2 class="tw-scene-title">@entry.Frame.Title</h2>
        }

        <DocumentView Document="entry.Frame.Document" />

        @if (entry.Chosen is not null)
        {
            <p class="tw-chosen">→ <InlineView Inlines="entry.Chosen" /></p>
        }
    </text>;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_startedStory, Story))
        {
            Restart();
        }

        if (Visible && !_wasVisible)
        {
            _focusLatest = true;
        }

        _wasVisible = Visible;
    }

    private void Restart()
    {
        _startedStory = Story;
        _session = new StorySession(Story, Seed);
        _transcript.Clear();
        Append(_session.Start());
    }

    private void Choose(ChoiceView choice)
    {
        _transcript[^1].Chosen = choice.Label;
        Append(_session.Choose(choice.Key));
    }

    private void Append(StoryFrame frame)
    {
        _transcript.Add(new TranscriptEntry(frame));
        _focusLatest = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLatest && Visible)
        {
            _focusLatest = false;

            // Scroll the newest frame to the top and focus it, so the new text is visible and screen readers move to it.
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Talewright.Player/Components/StoryPlayer.razor.js");
                await _module.InvokeVoidAsync("revealLatest", _latestFrame, _transcript.Count == 1);
            }
            catch (JSException)
            {
                await FocusLatestAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
                // The element can disappear if the player restarts mid-render; nothing to reveal then.
            }
        }
    }

    private async Task FocusLatestAsync()
    {
        try
        {
            await _latestFrame.FocusAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
