@* Plays one compiled story: transcript of everything so far, current choices, and a character sheet. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@using Talewright.Runtime.Saves

<div class="tw-player">
    <header class="tw-bar">
        <h1>@Story.Title</h1>
        <div class="tw-bar-actions">
            @if (Story.UndoEnabled)
            {
                <button type="button" class="tw-link" disabled="@(_busy || !_session.CanBack)" @onclick="Back">Back</button>
                <button type="button" class="tw-link" disabled="@(_busy || !_session.CanForward)" @onclick="Forward">Forward</button>
            }
            @if (SaveStore is not null)
            {
                <button type="button" class="tw-link" disabled="@_busy" @onclick="ShowSavesAsync">Saved games</button>
            }
            <button type="button" class="tw-link" disabled="@_busy" @onclick="Restart">Restart</button>
            @if (OnExit.HasDelegate)
            {
                <button type="button" class="tw-link" disabled="@_busy" @onclick="() => OnExit.InvokeAsync()">Library</button>
            }
        </div>
    </header>

    @if (_showSaves && SaveStore is not null)
    {
        <fieldset class="tw-saves" disabled="@_busy">
            <legend>Saved games</legend>
            <label>Save name <input aria-label="Save name" @bind="_slot" maxlength="64" /></label>
            <button type="button" @onclick="() => SaveAsync(false)">Save game</button>
            <button type="button" @onclick="RefreshSlotsAsync">Refresh saves</button>
            @if (_pendingOverwrite == _slot.Trim())
            {
                <p>Replace save “@_pendingOverwrite”?</p>
                <button type="button" @onclick="() => SaveAsync(true)">Confirm overwrite</button>
                <button type="button" @onclick="() => _pendingOverwrite = null">Cancel overwrite</button>
            }
            @if (_slots.Count == 0)
            {
                <p>No saved games.</p>
            }
            @foreach (var slot in _slots)
            {
                <button type="button" @onclick="() => LoadAsync(slot)">Load @slot</button>
            }
        </fieldset>
    }
    @if (_saveMessage is not null)
    {
        <p class="@(_saveError ? "tw-error" : "tw-save-status")" role="@(_saveError ? "alert" : "status")">@_saveMessage</p>
    }

    <div class="tw-columns">
        <main class="tw-transcript" aria-label="Story transcript" aria-live="polite">
            @for (var i = 0; i < _transcript.Count; i++)
            {
                var entry = _transcript[i];
                var isLatest = i == _transcript.Count - 1;
                if (isLatest)
                {
                    <section class="tw-frame tw-latest" aria-label="Current passage" tabindex="-1" @ref="_latestFrame">@FrameContent(entry)</section>
                }
                else
                {
                    <section class="tw-frame tw-past">@FrameContent(entry)</section>
                }
            }

            @if (_session.Current is { } current)
            {
                if (current.IsEnded)
                {
                    <p class="tw-the-end">The End</p>
                    <button type="button" class="tw-choice" disabled="@_busy" @onclick="Restart">Play again</button>
                }
                else
                {
                    <ol class="tw-choices" aria-label="Story choices">
                        @for (var i = 0; i < current.Choices.Count; i++)
                        {
                            var choice = current.Choices[i];
                            <li>
                                <button type="button" class="tw-choice" disabled="@_busy" @onclick="() => Choose(choice)">
                                    <span class="tw-choice-number">@(i + 1).</span>
                                    <InlineView Inlines="choice.Label" />
                                </button>
                            </li>
                        }
                    </ol>
                }
            }
        </main>

        <CharacterSheet State="_session.State" />
    </div>
</div>

@code {
    /// <summary>The compiled story to play.</summary>
    [Parameter, EditorRequired]
    public StoryDefinition Story { get; set; } = default!;

    /// <summary>Optional fixed seed (for reproducing a playthrough); otherwise the story's seed or a random one.</summary>
    [Parameter]
    public ulong? Seed { get; set; }

    /// <summary>Raised when the player asks to go back to the library. The button is hidden if unset.</summary>
    [Parameter]
    public EventCallback OnExit { get; set; }

    /// <summary>False while the host hides the player (e.g. behind the library); becoming visible again re-reveals the newest frame.</summary>
    [Parameter]
    public bool Visible { get; set; } = true;

    [Parameter]
    public ISaveStore? SaveStore { get; set; }

    private IReadOnlyList<HistoryFrame> _transcript => _session.Transcript;
    private ElementReference _latestFrame;
    private StoryHistory _session = default!;
    private StoryDefinition? _startedStory;
    private bool _focusLatest;
    private bool _wasVisible = true;
    private IJSObjectReference? _module;
    private bool _busy;
    private bool _showSaves;
    private bool _saveError;
    private int _generation;
    private string _slot = "My save";
    private string? _pendingOverwrite;
    private string? _saveMessage;
    private IReadOnlyList<string> _slots = [];

    private RenderFragment FrameContent(HistoryFrame entry) => @<text>
        @if (!string.IsNullOrEmpty(entry.Frame.Title))
        {
            <h2 class="tw-scene-title">@entry.Frame.Title</h2>
        }

        <DocumentView Document="entry.Frame.Document" />

        @if (entry.Chosen is not null)
        {
            <p class="tw-chosen">→ <InlineView Inlines="entry.Chosen" /></p>
        }
    </text>;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_startedStory, Story))
        {
            Restart();
        }

        if (Visible && !_wasVisible)
        {
            _focusLatest = true;
        }

        _wasVisible = Visible;
    }

    private void Restart()
    {
        _startedStory = Story;
        _session = new StoryHistory(Story, Seed);
        _generation++;
        _busy = false;
        _showSaves = false;
        _pendingOverwrite = null;
        _saveMessage = null;
        _slots = [];
        _focusLatest = true;
    }

    private void Choose(ChoiceView choice)
    {
        _session.Choose(choice.Key);
        _focusLatest = true;
    }

    private void Back()
    {
        _session.Back();
        _focusLatest = true;
    }

    private void Forward()
    {
        _session.Forward();
        _focusLatest = true;
    }

    private async Task ShowSavesAsync()
    {
        _showSaves = !_showSaves;
        if (_showSaves)
        {
            await RefreshSlotsAsync();
        }
    }

    private Task RefreshSlotsAsync() => SaveOperationAsync(async generation =>
    {
        var slots = await SaveStore!.ListAsync(Story.Id);
        if (generation == _generation)
        {
            _slots = slots;
        }
    });

    private Task SaveAsync(bool overwrite)
    {
        var slot = _slot.Trim();
        if (!overwrite && _slots.Contains(slot, StringComparer.Ordinal))
        {
            _pendingOverwrite = slot;
            return Task.CompletedTask;
        }

        return SaveOperationAsync(async generation =>
        {
            if (overwrite && _pendingOverwrite != slot)
            {
                throw new InvalidOperationException("Confirm the selected save before overwriting it.");
            }

            var id = Story.Id;
            await SaveStore!.WriteAsync(id, slot, _session.Save(), overwrite);
            var slots = await SaveStore.ListAsync(id);
            if (generation == _generation)
            {
                _pendingOverwrite = null;
                _saveMessage = $"Saved '{slot}'.";
                _slots = slots;
            }
        });
    }

    private Task LoadAsync(string slot) => SaveOperationAsync(async generation =>
    {
        var story = Story;
        var bytes = await SaveStore!.ReadAsync(story.Id, slot);
        var candidate = StoryHistory.Restore(story, bytes);
        if (generation == _generation)
        {
            _session = candidate;
            _pendingOverwrite = null;
            _saveMessage = $"Loaded '{slot}'.";
            _focusLatest = true;
        }
    });

    private async Task SaveOperationAsync(Func<int, Task> operation)
    {
        if (_busy)
        {
            return;
        }

        var generation = _generation;
        _busy = true;
        _saveMessage = null;
        _saveError = false;
        try
        {
            await operation(generation);
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException or ArgumentException or InvalidOperationException or JSException)
        {
            if (generation == _generation)
            {
                _saveError = true;
                _saveMessage = $"Couldn't complete save operation: {ex.Message}";
            }
        }
        finally
        {
            if (generation == _generation)
            {
                _busy = false;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLatest && Visible)
        {
            _focusLatest = false;

            // Scroll the newest frame to the top and focus it, so the new text is visible and screen readers move to it.
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Talewright.Player/Components/StoryPlayer.razor.js");
                await _module.InvokeVoidAsync("revealLatest", _latestFrame, _transcript.Count == 1);
            }
            catch (JSException)
            {
                await FocusLatestAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
                // The element can disappear if the player restarts mid-render; nothing to reveal then.
            }
        }
    }

    private async Task FocusLatestAsync()
    {
        try
        {
            await _latestFrame.FocusAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
