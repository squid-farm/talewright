@implements IAsyncDisposable
@inject IJSRuntime JS

<header class="tw-bar" aria-label="Player toolbar" @ref="_bar">
    <h1>@Title</h1>
    <div class="tw-bar-actions">
        @if (UndoEnabled)
        {
            <button type="button" class="tw-link" disabled="@(Busy || !CanBack)" @onclick="OnBack">Back</button>
            <button type="button" class="tw-link" disabled="@(Busy || !CanForward)" @onclick="OnForward">Forward</button>
        }
        @if (CanSave)
        {
            <button type="button" class="tw-link" disabled="@Busy" @onclick="OnSavedGames">Saved games</button>
        }
        <div class="tw-overflow">
            <button type="button" class="tw-link" aria-expanded="@(_menuOpen ? "true" : "false")"
                    disabled="@(Busy || !_initialized)" @onclick="ToggleMenu" @ref="_toggle">More actions</button>
            <div class="tw-overflow-actions" hidden="@(!_menuOpen)" @ref="_menu">
                <button type="button" class="tw-link" disabled="@Busy" @onclick="ConfirmRestart">Restart</button>
                @if (OnExit.HasDelegate)
                {
                    <button type="button" class="tw-link" disabled="@Busy" @onclick="Exit">Library</button>
                }
            </div>
        </div>
    </div>
</header>

<dialog class="tw-confirm" aria-label="Restart story?" @ref="_confirmation">
    <h2>Restart story?</h2>
    <p>This discards your current playthrough. Saved games are kept.</p>
    <div class="tw-confirm-actions">
        <button type="button" class="tw-choice" @onclick="CancelRestart" autofocus>Keep playing</button>
        <button type="button" class="tw-choice" @onclick="Restart">Restart story</button>
    </div>
</dialog>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool UndoEnabled { get; set; }
    [Parameter] public bool CanBack { get; set; }
    [Parameter] public bool CanForward { get; set; }
    [Parameter] public bool CanSave { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnForward { get; set; }
    [Parameter] public EventCallback OnSavedGames { get; set; }
    [Parameter] public EventCallback OnRestart { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }

    private ElementReference _bar, _toggle, _menu, _confirmation;
    private IJSObjectReference? _module;
    private bool _menuOpen;
    private bool _initialized;
    private bool _focusMenu;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Talewright.Player/Components/PlayerToolbar.razor.js");
            await _module.InvokeVoidAsync("initialize", _bar, _toggle, _menu, _confirmation);
            _initialized = true;
            StateHasChanged();
        }
        if (_focusMenu)
        {
            _focusMenu = false;
            await _module!.InvokeVoidAsync("focusMenu", _menu);
        }
    }

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
        _focusMenu = _menuOpen;
    }

    private async Task ConfirmRestart()
    {
        _menuOpen = false;
        await _module!.InvokeVoidAsync("openConfirmation", _confirmation);
    }

    private async Task CancelRestart() =>
        await _module!.InvokeVoidAsync("closeConfirmation", _confirmation, _toggle);

    private async Task Restart()
    {
        await CancelRestart();
        await OnRestart.InvokeAsync();
    }

    private async Task Exit()
    {
        _menuOpen = false;
        await OnExit.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", _bar);
            await _module.DisposeAsync();
        }
    }
}
