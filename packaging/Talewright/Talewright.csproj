<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(TalewrightLibraryTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>The headless Talewright engine: story compilation, rules, narrative rendering, and runtime.</Description>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeEngineAssemblies</TargetsForTfmSpecificBuildOutput>
    <BuildProjectReferences Condition="'$(NoBuild)' == 'true'">false</BuildProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <None Include="buildTransitive/Talewright.targets" Pack="true" PackagePath="buildTransitive/" />
    <ProjectReference Include="../../engine/src/Talewright.Core/Talewright.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../engine/src/Talewright.Graphs/Talewright.Graphs.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../engine/src/Talewright.Rules/Talewright.Rules.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../engine/src/Talewright.Narrative/Talewright.Narrative.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../engine/src/Talewright.Rulesets.Generic/Talewright.Rulesets.Generic.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../engine/src/Talewright.Talemark/Talewright.Talemark.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../engine/src/Talewright.Runtime/Talewright.Runtime.csproj" PrivateAssets="all" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <Target Name="IncludeEngineAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' And '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->'%(RootDir)%(Directory)%(Filename).xml')"
                            Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' And '%(ReferenceCopyLocalPaths.Extension)' == '.dll' And Exists('%(ReferenceCopyLocalPaths.RootDir)%(ReferenceCopyLocalPaths.Directory)%(ReferenceCopyLocalPaths.Filename).xml')" />
    </ItemGroup>
  </Target>
</Project>
